{
  "PanelFleet": {
    "Listen": {
      "Url": "http://127.0.0.1:5188"
    },
    "DataDirectory": "",
    "ForwardedHeaders": {
      "Enabled": false
    }
  },
  "Oidc": {
    "Authority": "",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/sso/OIDC/Callback",
    "SignedOutCallbackPath": "/sso/OIDC/SignedOut",
    "RedirectUri": "",
    "RequireHttpsMetadata": true,
    "Scopes": [ "openid", "profile", "email" ],
    "RoleClaimType": "groups",
    "AdminRoles": [],
    "ReadOnlyRoles": []
  },
  "Auth": {
    "AllowedEmails": [],
    "AllowedSubjects": []
  },
  "Health": {
    "IntervalSeconds": 60,
    "MaxConcurrency": 4,
    "TimeoutSeconds": 8
  },
  "Overview": {
    "RefreshIntervalSeconds": 30,
    "CacheTtlSeconds": 25,
    "StaleAfterSeconds": 90,
    "MaxConcurrency": 6,
    "NodeTimeoutSeconds": 6,
    "BudgetSeconds": 10,
    "Circuit": {
      "FailureThreshold": 3,
      "BreakSeconds": 30
    }
  },
  "Resources": {
    "CacheTtlSeconds": 30,
    "DetailCacheTtlSeconds": 60,
    "NodeTimeoutSeconds": 10,
    "BudgetSeconds": 15,
    "MaxConcurrency": 6,
    "PerNodeLimit": 200,
    "MergeLimit": 2000,
    "RefreshIntervalSeconds": 60,
    "AccessTtlSeconds": 600
  },
  "Operations": {
    "ConfirmationTtlSeconds": 120,
    "MaxBatchNodes": 50,
    "NodeLockTimeoutSeconds": 5,
    "ExecuteTimeoutSeconds": 120,
    "DedupeWindowSeconds": 10,
    "HistoryCapacity": 200
  },
  "Terminal": {
    "Enabled": true,
    "IdleTimeoutSeconds": 1800,
    "MaxSessionMinutes": 240,
    "MaxFrameBytes": 65536,
    "MaxInputFramesPerSecond": 30,
    "MaxInputBytesPerSecond": 131072,
    "MaxConcurrentSessions": 20,
    "AllowedOrigins": [],
    "AllowMissingOrigin": true
  },
  "OnePanel": {
    "RequestTimeout": "00:00:08",
    "ConnectTimeout": "00:00:05",
    "PooledConnectionLifetime": "00:05:00",
    "MaxConnectionsPerServer": 4
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
