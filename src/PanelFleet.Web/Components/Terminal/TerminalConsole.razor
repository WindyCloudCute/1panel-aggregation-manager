@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="terminal-surface" @ref="_host"></div>

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<TerminalConsole>? _dotNetReference;
    private Task? _initialization;
    private bool _disposed;

    /// <summary>终端字号（px）。</summary>
    [Parameter]
    public int FontSize { get; set; } = 14;

    /// <summary>JS 侧事件回调（连接状态/ready/错误/断开/延迟/降级模式）。</summary>
    [Parameter]
    public EventCallback<TerminalEvent> OnEvent { get; set; }

    /// <summary>是否已初始化终端渲染器。</summary>
    public bool IsReady { get; private set; }

    /// <summary>是否处于零依赖简易终端模式（xterm 本地资源不可用时）。</summary>
    public bool IsSimpleMode { get; private set; }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive)
        {
            return Task.CompletedTask;
        }

        return EnsureInitializedAsync();
    }

    /// <summary>初始化 JS 终端（幂等）。</summary>
    public Task EnsureInitializedAsync()
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        return _initialization ??= InitializeCoreAsync();
    }

    private async Task InitializeCoreAsync()
    {
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./vendor/xterm/terminal-loader.js");
            _dotNetReference = DotNetObjectReference.Create(this);
            _handle = await _module.InvokeAsync<IJSObjectReference>(
                "createTerminal",
                _host,
                _dotNetReference,
                new { fontSize = FontSize });
            IsReady = true;
        }
        catch (JSDisconnectedException)
        {
            // 页面已卸载。
        }
        catch (Exception)
        {
            _initialization = null;
            throw;
        }
    }

    /// <summary>连接终端 WebSocket。</summary>
    public Task ConnectAsync(string url) => InvokeHandleAsync("connect", url);

    /// <summary>主动断开终端。</summary>
    public Task DisconnectAsync() => InvokeHandleAsync("disconnect");

    /// <summary>调整字号。</summary>
    public Task SetFontSizeAsync(int fontSize) => InvokeHandleAsync("setFontSize", fontSize);

    /// <summary>聚焦终端。</summary>
    public Task FocusAsync() => InvokeHandleAsync("focus");

    /// <summary>清屏。</summary>
    public Task ClearAsync() => InvokeHandleAsync("clear");

    /// <summary>JS 事件入口（由 DotNetObjectReference 调用）。</summary>
    [JSInvokable]
    public async Task OnTerminalEvent(TerminalEvent terminalEvent)
    {
        if (terminalEvent.Kind == "mode")
        {
            IsSimpleMode = string.Equals(terminalEvent.Mode, "simple", StringComparison.Ordinal);
        }

        await OnEvent.InvokeAsync(terminalEvent);
    }

    private async Task InvokeHandleAsync(string method, object? argument = null)
    {
        if (_handle is null)
        {
            return;
        }

        try
        {
            if (argument is null)
            {
                await _handle.InvokeVoidAsync(method);
            }
            else
            {
                await _handle.InvokeVoidAsync(method, argument);
            }
        }
        catch (JSDisconnectedException)
        {
            // ignore
        }
        catch (ObjectDisposedException)
        {
            // ignore
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // 页面已卸载。
        }
        catch (ObjectDisposedException)
        {
            // ignore
        }
        finally
        {
            _dotNetReference?.Dispose();
        }
    }
}
