@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

@* 首屏立即应用深浅色主题，避免闪烁；切换按钮使用原生 onclick（内联 SVG 图标，无外部 JS）。 *@
<script>
    (function () {
        var THEME_KEY = 'panelfleet-theme';
        var root = document.documentElement;
        var stored = null;
        try { stored = localStorage.getItem(THEME_KEY); } catch (e) { stored = null; }
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = stored === 'dark' || stored === 'light' ? stored : (prefersDark ? 'dark' : 'light');
        root.setAttribute('data-theme', theme);

        window.toggleTheme = function () {
            var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            try { localStorage.setItem(THEME_KEY, next); } catch (e) { }
        };
    })();
</script>

<div class="app-shell @(_navOpen ? "nav-open" : null)">
    <div class="sidebar-backdrop" @onclick="CloseNav"></div>

    <aside class="sidebar" aria-label="主导航">
        <div class="sidebar-head">
            <a class="brand" href="/">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="6" rx="2"></rect>
                        <rect x="3" y="14" width="18" height="6" rx="2"></rect>
                        <path d="M7 7h.01M7 17h.01"></path>
                    </svg>
                </span>
                <span class="brand-name">1Panel Aggregation Manager</span>
            </a>
            <button type="button" class="icon-button sidebar-close" title="关闭导航" aria-label="关闭导航"
                    @onclick="CloseNav">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 6l12 12M18 6L6 18"></path>
                </svg>
            </button>
        </div>

        <NavMenu />

        <div class="sidebar-footer">
            <span class="status-dot" aria-hidden="true"></span>
            <span>1Panel Aggregation Manager</span>
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button type="button" class="icon-button nav-toggle" title="打开导航" aria-label="打开导航"
                        aria-expanded="@(_navOpen ? "true" : "false")" @onclick="ToggleNav">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
                <span class="topbar-title">多服务器聚合管理</span>
            </div>

            <div class="topbar-right">
                <button type="button" class="icon-button theme-toggle" title="切换深浅色主题"
                        aria-label="切换深浅色主题" onclick="toggleTheme()">
                    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
                    </svg>
                    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="4"></circle>
                        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
                    </svg>
                </button>

                <AuthorizeView>
                    <Authorized>
                        <div class="user-area">
                            <span class="user">@DisplayName(context.User)</span>
                            <form method="post" action="/logout" class="inline">
                                <AntiforgeryToken />
                                <button type="submit" class="link-button">退出</button>
                            </form>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="content">
            @* 路由变化时重建容器，让 .page-enter 进入动画重新播放 *@
            <div class="page-enter" @key="Navigation.Uri">
                @Body
            </div>
        </main>
    </div>
</div>

@code {
    private bool _navOpen;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        _navOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleNav() => _navOpen = !_navOpen;

    private void CloseNav() => _navOpen = false;

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private static string DisplayName(System.Security.Claims.ClaimsPrincipal principal) =>
        principal.FindFirst("name")?.Value
        ?? principal.FindFirst("email")?.Value
        ?? principal.Identity?.Name
        ?? "已登录";
}
