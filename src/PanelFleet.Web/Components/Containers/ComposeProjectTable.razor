@using PanelFleet.Application.Containers

@if (Rows.Count == 0)
{
    <div class="resource-empty">
        <p>暂无 Compose 项目。</p>
        <p class="muted small">可切换节点筛选、点击「新建项目」或「刷新」重新采集。</p>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table compose-table">
            <thead>
                <tr>
                    <th>项目</th>
                    <th>状态</th>
                    <th>容器</th>
                    <th>来源</th>
                    <th>节点</th>
                    <th class="col-actions">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Rows)
                {
                    var active = IsActive(row);
                    <tr class="@RowClass(active)">
                        <td>
                            <div class="compose-name">@row.Name</div>
                            <div class="muted small mono cell-ellipsis" title="@row.Path">@row.Path</div>
                            @if (!row.ComposeFileExists)
                            {
                                <div class="muted small warn-text">Compose 文件缺失，操作可能失败。</div>
                            }
                        </td>
                        <td>
                            <span class="badge @StatusClass(row)">@StatusText(row)</span>
                            <div class="muted small">@row.RunningCount / @row.ContainerCount 运行</div>
                        </td>
                        <td>
                            @if (row.Containers.Count == 0)
                            {
                                <span class="muted">—</span>
                            }
                            else
                            {
                                @foreach (var container in row.Containers.Take(4))
                                {
                                    <div class="muted small mono">@container.Name · @container.State</div>
                                }
                                @if (row.Containers.Count > 4)
                                {
                                    <div class="muted small">+@(row.Containers.Count - 4) 个容器</div>
                                }
                            }
                        </td>
                        <td class="muted">@row.CreatedBy</td>
                        <td class="muted">@row.NodeName</td>
                        <td class="col-actions" @onclick:stopPropagation="true">
                            <div class="row-actions">
                                <button type="button" class="btn btn-xs" @onclick="() => EditAsync(row)">编辑</button>
                                @if (row.RunningCount < row.ContainerCount || row.ContainerCount == 0)
                                {
                                    <button type="button" class="btn btn-xs" @onclick="() => UpAsync(row)">启动</button>
                                }
                                @if (row.RunningCount > 0)
                                {
                                    <button type="button" class="btn btn-xs" @onclick="() => StopAsync(row)">停止</button>
                                    <button type="button" class="btn btn-xs" @onclick="() => RestartAsync(row)">重启</button>
                                }
                                <button type="button" class="btn btn-xs" @onclick="() => RebuildAsync(row)">重建</button>
                                <button type="button" class="btn btn-xs" @onclick="() => DownAsync(row)">移除</button>
                                <button type="button" class="btn btn-xs btn-danger" @onclick="() => DeleteAsync(row)">删除</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ComposeProjectRow> Rows { get; set; } = [];

    [Parameter]
    public EventCallback<(ComposeProjectRow Row, string Kind)> OnOperate { get; set; }

    /// <summary>打开编辑对话框（YAML 预填由对话框自行加载）。</summary>
    [Parameter]
    public EventCallback<ComposeProjectRow> OnEdit { get; set; }

    /// <summary>打开删除选项对话框（确认文本由 OperationConfirmDialog 收集）。</summary>
    [Parameter]
    public EventCallback<ComposeProjectRow> OnDelete { get; set; }

    /// <summary>当前从左侧树定位到的 Compose 项目键（nodeId/name），用于行高亮。</summary>
    [Parameter]
    public string? ActiveKey { get; set; }

    private bool IsActive(ComposeProjectRow row) =>
        !string.IsNullOrEmpty(ActiveKey) &&
        string.Equals(ActiveKey, row.NodeId.ToString("N") + "/" + row.Name, StringComparison.Ordinal);

    private static string RowClass(bool active) => "compose-row" + (active ? " is-active" : string.Empty);

    private static string StatusText(ComposeProjectRow row) =>
        row.ContainerCount == 0 ? "未运行" : row.RunningCount == row.ContainerCount ? "运行中" : "部分运行";

    private static string StatusClass(ComposeProjectRow row) =>
        row.ContainerCount == 0 ? "badge-unknown" : row.RunningCount == row.ContainerCount ? "badge-ok" : "badge-warn";

    private Task EditAsync(ComposeProjectRow row) => OnEdit.InvokeAsync(row);

    private Task DeleteAsync(ComposeProjectRow row) => OnDelete.InvokeAsync(row);

    private Task UpAsync(ComposeProjectRow row) => OnOperate.InvokeAsync((row, "compose.up"));

    private Task StopAsync(ComposeProjectRow row) => OnOperate.InvokeAsync((row, "compose.stop"));

    private Task RestartAsync(ComposeProjectRow row) => OnOperate.InvokeAsync((row, "compose.restart"));

    private Task RebuildAsync(ComposeProjectRow row) => OnOperate.InvokeAsync((row, "compose.rebuild"));

    private Task DownAsync(ComposeProjectRow row) => OnOperate.InvokeAsync((row, "compose.down"));
}
