    private async Task SelectContainerLeafAsync(Guid nodeId, string name)
    {
        var leafId = ContainerLeafId(nodeId, name);
        if (string.Equals(_selectedTreeId, leafId, StringComparison.Ordinal)
            && _preview is not null
            && _activeRowKey is not null)
        {
            // 重复点击同一个容器：不再刷新任何数据（避免反复请求、页面闪动）。
            return;
        }

        _treeOpen = false;
        _tab = "containers";
        _nodeFilterValue = nodeId.ToString();
        _selectedTreeId = leafId;
        _expandRequest.Add(NodeKey(nodeId));
        _searchInput = name;
        _nameFilter = name;
        _page = 1;
        _activeComposeKey = null;

        var row = _containers?.Rows.FirstOrDefault(item =>
            item.NodeId == nodeId && string.Equals(item.Name, name, StringComparison.Ordinal));

        if (row is null)
        {
            await EnsureNodeContainersAsync(nodeId);
            await LoadContainersAsync();

            row = _containers?.Rows.FirstOrDefault(item =>
                item.NodeId == nodeId && string.Equals(item.Name, name, StringComparison.Ordinal));
        }
        if (row is null)
        {
            _activeRowKey = null;
            _urlSelectionName = null;
            _error = "未在节点上找到容器「" + name + "」，可能已被删除或名称不匹配。";
        }
        else
        {
            _activeRowKey = ContainerTable.Key(row);
            _urlSelectionName = row.Name;
            await OpenDetailAsync(row);
        }

        await PersistSelectionAsync();
        await SyncUrlAsync();
    }

    private async Task SelectComposeLeafAsync(Guid nodeId, string name)
    {
        _treeOpen = false;
        _tab = "compose";
        _nodeFilterValue = nodeId.ToString();
        _selectedTreeId = ComposeLeafId(nodeId, name);
        _expandRequest.Add(NodeKey(nodeId));
        _page = 1;
        _activeRowKey = null;

        await EnsureNodeComposeAsync(nodeId);
        await LoadComposeAsync();

        var project = _compose?.Projects.FirstOrDefault(item =>
            item.NodeId == nodeId && string.Equals(item.Name, name, StringComparison.Ordinal));
        if (project is null)
        {
            _activeComposeKey = null;
            _urlSelectionName = null;
            _composeError = "未找到 Compose 项目「" + name + "」。";
        }
        else
        {
            _activeComposeKey = ComposeKey(project);
            _urlSelectionName = project.Name;
        }

        await PersistSelectionAsync();
        await SyncUrlAsync();
    }

    private async Task LocateContainerAsync(string name)
    {
        var row = _containers?.Rows.FirstOrDefault(item => string.Equals(item.Name, name, StringComparison.Ordinal));
        if (row is null)
        {
            _tab = "containers";
            _searchInput = name;
            _nameFilter = name;
            _page = 1;
            await LoadContainersAsync();
            row = _containers?.Rows.FirstOrDefault(item => string.Equals(item.Name, name, StringComparison.Ordinal));
        }

        if (row is not null)
        {
            _tab = "containers";
            _selectedTreeId = ContainerLeafId(row.NodeId, row.Name);
            _activeRowKey = ContainerTable.Key(row);
            _urlSelectionName = row.Name;
            _expandRequest.Add(NodeKey(row.NodeId));
            await EnsureNodeContainersAsync(row.NodeId);
            await OpenDetailAsync(row);
            await PersistSelectionAsync();
            return;
        }

        _tab = "compose";
        await LoadComposeAsync();
        var project = _compose?.Projects.FirstOrDefault(item => string.Equals(item.Name, name, StringComparison.Ordinal));
        if (project is not null)
        {
            _selectedTreeId = ComposeLeafId(project.NodeId, project.Name);
            _activeComposeKey = ComposeKey(project);
            _urlSelectionName = project.Name;
            _expandRequest.Add(NodeKey(project.NodeId));
            await EnsureNodeComposeAsync(project.NodeId);
            await PersistSelectionAsync();
            await SyncUrlAsync();
            return;
        }

        _error = "未找到容器或 Compose 项目「" + name + "」。";
        await PersistSelectionAsync();
    }

    private async Task EnsureNodeContainersAsync(Guid nodeId, bool force = false)
    {
        var key = NodeKey(nodeId) + ":containers";
        if (!force && _nodeContainersLoaded.Contains(nodeId))
        {
            return;
        }

        if (_treeLoading.Contains(key))
        {
            return;
        }

        _treeLoading.Add(key);
        _treeErrors.Remove(key);
        _treeErrors.Remove(NodeKey(nodeId));
        try
        {
            var result = await ContainerService.ListAsync(
                new ContainerQuery(nodeId, null, "all", "name", "ascending", 1, TreePageSize),
                Token);
            _nodeContainers[nodeId] = result.Rows.Select(BuildContainerLeaf).ToArray();
            _nodeContainersLoaded.Add(nodeId);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            var message = "加载失败：" + exception.Message;
            _treeErrors[key] = message;
            _treeErrors[NodeKey(nodeId)] = message;
        }
        finally
        {
            _treeLoading.Remove(key);
        }
    }

    private async Task EnsureNodeComposeAsync(Guid nodeId, bool force = false)
    {
        var key = NodeKey(nodeId) + ":compose";
        if (!force && _nodeComposeLoaded.Contains(nodeId))
        {
            return;
        }

        if (_treeLoading.Contains(key))
        {
            return;
        }

        _treeLoading.Add(key);
        _treeErrors.Remove(key);
        try
        {
            var result = await ContainerService.ListComposeAsync(
                new ContainerQuery(nodeId, null, "all", "name", "ascending", 1, TreePageSize),
                Token);
            _nodeCompose[nodeId] = result.Projects.Select(BuildComposeLeaf).ToArray();
            _nodeComposeLoaded.Add(nodeId);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            _treeErrors[key] = "加载失败：" + exception.Message;
        }
        finally
        {
            _treeLoading.Remove(key);
        }
    }

    private static string NodeKey(Guid nodeId) => "node:" + nodeId.ToString("N");

    private static string ContainerLeafId(Guid nodeId, string name) => "container:" + nodeId.ToString("N") + ":" + name;

    private static string ComposeLeafId(Guid nodeId, string name) => "compose:" + nodeId.ToString("N") + ":" + name;

    private static string ComposeKey(ComposeProjectRow project) => project.NodeId.ToString("N") + "/" + project.Name;

    private static bool TryParseNodeTreeId(string id, out Guid nodeId, out string? group)
    {
        nodeId = Guid.Empty;
        group = null;
        if (!id.StartsWith("node:", StringComparison.Ordinal))
        {
            return false;
        }

        var rest = id[5..];
        var separator = rest.IndexOf(':');
        var guidText = separator < 0 ? rest : rest[..separator];
        group = separator < 0 ? null : rest[(separator + 1)..];
        return Guid.TryParseExact(guidText, "N", out nodeId);
    }

    private static bool TryParseLeafId(string id, out string kind, out Guid nodeId, out string name)
    {
        kind = string.Empty;
        nodeId = Guid.Empty;
        name = string.Empty;
        var parts = id.Split(':', 3);
        if (parts.Length != 3)
        {
            return false;
        }

        if (!string.Equals(parts[0], "container", StringComparison.Ordinal) &&
            !string.Equals(parts[0], "compose", StringComparison.Ordinal))
        {
            return false;
        }

        if (!Guid.TryParseExact(parts[1], "N", out nodeId) || string.IsNullOrWhiteSpace(parts[2]))
        {
            return false;
        }

        kind = parts[0];
        name = parts[2];
        return true;
    }

    private async Task PersistSelectionAsync()
    {
        if (!_interactive)
        {
            return;
        }

        try
        {
            var memory = new ContainerTreeMemory(
                string.IsNullOrWhiteSpace(_nodeFilterValue) ? null : _nodeFilterValue,
                _tab);
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, JsonSerializer.Serialize(memory));
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task<bool> RestoreSelectionAsync()
    {
        if (NodeId is not null || !string.IsNullOrWhiteSpace(Container))
        {
            return false;
        }

        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            if (string.IsNullOrWhiteSpace(json))
            {
                return false;
            }

            var memory = JsonSerializer.Deserialize<ContainerTreeMemory>(json);
            if (memory is null)
            {
                return false;
            }

            var tab = string.Equals(memory.Tab, "compose", StringComparison.Ordinal) ? "compose" : "containers";
            if (Guid.TryParse(memory.NodeId, out var nodeId) && _nodes.Any(node => node.Id.Value == nodeId))
            {
                _tab = tab;
                _nodeFilterValue = nodeId.ToString();
                _selectedTreeId = NodeKey(nodeId);
                _expandRequest.Add(NodeKey(nodeId));
                await LoadAsync();
                return true;
            }

            if (string.Equals(tab, "compose", StringComparison.Ordinal))
            {
                _tab = tab;
                await LoadComposeAsync();
                return true;
            }

            return false;
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        catch (JsonException)
        {
        }

        return false;
    }

    private async Task SyncUrlAsync()
    {
        if (!_interactive)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("history.replaceState", null, string.Empty, BuildUrl());
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private string BuildUrl()
    {
        var query = new List<string>(2);
        if (NodeFilter is { } nodeId)
        {
            query.Add("nodeId=" + nodeId.ToString("N"));
        }

        if (!string.IsNullOrWhiteSpace(_urlSelectionName))
        {
            query.Add("id=" + Uri.EscapeDataString(_urlSelectionName));
        }

        return query.Count == 0 ? "/containers" : "/containers?" + string.Join("&", query);
    }

    private sealed record ContainerTreeMemory(string? NodeId, string? Tab);

    private static RenderFragment NodeResultStrip(IReadOnlyList<ContainerNodeResult> nodes, DateTimeOffset generatedAt) => builder =>
    {
        BuildNodeStrip(
            builder,
            nodes.Select(node => (node.NodeName, node.State, node.Error?.Message)).ToArray(),
            generatedAt);
    };

    private static RenderFragment NodeResultStrip(IReadOnlyList<ComposeNodeResult> nodes, DateTimeOffset generatedAt) => builder =>
    {
        BuildNodeStrip(
            builder,
            nodes.Select(node => (node.NodeName, node.State, node.Error?.Message)).ToArray(),
            generatedAt);
    };

    private static void BuildNodeStrip(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder,
        IReadOnlyList<(string NodeName, ContainerNodeState State, string? Error)> nodes,
        DateTimeOffset generatedAt)
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "node-status");
        builder.OpenElement(2, "div");
        builder.AddAttribute(3, "class", "node-status-head");
        builder.AddContent(4, "节点采集状态");
        builder.OpenElement(5, "span");
        builder.AddAttribute(6, "class", "muted small");
        builder.AddContent(7, "生成于 " + generatedAt.ToLocalTime().ToString("HH:mm:ss"));
        builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(8, "div");
        builder.AddAttribute(9, "class", "node-status-list");
        var sequence = 10;
        foreach (var node in nodes)
        {
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", node.State == ContainerNodeState.Success
                ? "node-status-item"
                : "node-status-item node-status-error");
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "node-status-name");
            builder.AddContent(sequence++, node.NodeName);
            builder.CloseElement();
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "badge " + (node.State == ContainerNodeState.Success ? "badge-ok" : "badge-error"));
            builder.AddContent(sequence++, node.State == ContainerNodeState.Success ? "成功" : "失败");
            builder.CloseElement();
            if (!string.IsNullOrWhiteSpace(node.Error))
            {
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "node-status-error-text muted small");
                builder.AddContent(sequence++, node.Error);
                builder.CloseElement();
            }

            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();
    }
}
