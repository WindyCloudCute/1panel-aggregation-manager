    private async Task PreviewOperationAsync(string kind, IReadOnlyList<ContainerRow> targets, string source)
    {
        if (targets.Count == 0)
        {
            return;
        }

        var parameters = new JsonObject();
        if (targets.Count == 1)
        {
            parameters["container"] = targets[0].Name;
        }
        else
        {
            var byNode = new JsonObject();
            foreach (var group in targets.GroupBy(row => row.NodeId))
            {
                var names = new JsonArray();
                foreach (var row in group)
                {
                    names.Add(row.Name);
                }

                byNode[group.Key.ToString("N")] = names;
            }

            parameters["containersByNode"] = byNode;
        }

        parameters["source"] = source;

        var invocation = new OperationInvocation(
            kind,
            targets.Select(row => new NodeId(row.NodeId)).Distinct().ToArray(),
            parameters);
        await PreviewAsync(invocation);
    }

    private async Task PreviewAsync(OperationInvocation invocation)
    {
        _operationError = null;
        _execution = null;
        _operationBusy = true;
        try
        {
            var actor = await ActorProvider.GetAsync();
            _preview = await WriteOperations.PreviewAsync(invocation, actor, Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            _operationError = "预览操作失败：" + exception.Message;
        }
        finally
        {
            _operationBusy = false;
        }
    }

    private async Task ConfirmOperationAsync(string? typedConfirmation)
    {
        if (_preview is null)
        {
            return;
        }

        _operationBusy = true;
        _operationError = null;
        try
        {
            var actor = await ActorProvider.GetAsync();
            _execution = await WriteOperations.ExecuteAsync(_preview.TokenId, typedConfirmation, actor, Token);
            _preview = null;
            _selected.Clear();
            _nodeContainers.Clear();
            _nodeContainersLoaded.Clear();
            _nodeCompose.Clear();
            _nodeComposeLoaded.Clear();
            _treeErrors.Clear();
            if (NodeFilter is { } nodeId)
            {
                await EnsureNodeContainersAsync(nodeId);
            }

            await LoadAsync();
        }
        catch (OperationConfirmationException exception)
        {
            _operationError = "确认失败：" + exception.Message;
        }
        catch (OperationValidationException exception)
        {
            _operationError = "参数校验失败：" + exception.Message;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            _operationError = "执行失败：" + exception.Message;
        }
        finally
        {
            _operationBusy = false;
        }
    }

