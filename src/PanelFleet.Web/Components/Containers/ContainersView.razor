    private Task ToggleLogLive(bool live)
    {
        if (live)
        {
            StartLogPolling();
        }
        else
        {
            StopLogPolling();
        }

        return Task.CompletedTask;
    }

    private void StartLogPolling()
    {
        if (_logRow is null || _logLive)
        {
            return;
        }

        _logLive = true;
        _logLiveCts?.Cancel();
        _logLiveCts?.Dispose();
        _logLiveCts = CancellationTokenSource.CreateLinkedTokenSource(Token);
        _ = PollLogsAsync(_logLiveCts.Token);
    }

    private void StopLogPolling()
    {
        _logLive = false;
        if (_logLiveCts is null)
        {
            return;
        }

        try
        {
            _logLiveCts.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }

        _logLiveCts.Dispose();
        _logLiveCts = null;
    }

    /// <summary>每 2 秒拉取一次日志；请求在途时跳过，避免并发重叠。</summary>
    private async Task PollLogsAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (_logRow is null || _logRequestInFlight || !_logLive)
                {
                    continue;
                }

                await InvokeAsync(() => RefreshLogsLiveAsync(cancellationToken));
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task RefreshLogsLiveAsync(CancellationToken cancellationToken)
    {
        if (_logRow is not { } row || _logRequestInFlight)
        {
            return;
        }

        _logRequestInFlight = true;
        try
        {
            var log = await ContainerService.GetLogsAsync(
                row.NodeId,
                new ContainerLogRequest(row.Name, _logSince, _logTail, _logTimestamp),
                cancellationToken);
            _log = log;
            if (log.Error is { } error)
            {
                _logError = "日志读取失败：" + error.Message;
                StopLogPolling();
            }
            else
            {
                _logError = null;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            _logError = "日志读取失败：" + exception.Message;
            StopLogPolling();
        }
        finally
        {
            _logRequestInFlight = false;
        }

        StateHasChanged();
    }

    private void CloseLogs()
    {
        StopLogPolling();
        _logRow = null;
        _log = null;
        _logError = null;
        _logFullscreen = false;
        _logFollow = false;
        _logLive = false;
    }

