@using System.Text.Json
@using System.Text.Json.Nodes
@using Microsoft.JSInterop
@using PanelFleet.Application.Containers
@using PanelFleet.Web.Components.Terminal
@inject IContainerService ContainerService
@inject INodeService NodeService
@inject IWriteOperationService WriteOperations
@inject IActorProvider ActorProvider
@inject IJSRuntime JS

<div class="page-header">
    <div class="page-heading">
        <h1>容器管理</h1>
        <p class="muted small page-subtitle">按节点浏览容器与 Compose 项目；展开节点时才按需加载，首屏不会拉取全部节点数据。</p>
    </div>
    <div class="actions">
        @if (_containers is not null && _tab == "containers")
        {
            <span class="muted small">更新于 @_containers.GeneratedAt.ToLocalTime().ToString("HH:mm:ss")</span>
        }
        else if (_compose is not null && _tab == "compose")
        {
            <span class="muted small">更新于 @_compose.GeneratedAt.ToLocalTime().ToString("HH:mm:ss")</span>
        }
        @if (_loading)
        {
            <span class="muted small">加载中…</span>
        }
        <button type="button" class="btn tree-toggle" @onclick="OpenTree" aria-expanded="@_treeOpen.ToString().ToLowerInvariant()" aria-label="打开节点树">
            <ContainerIcon Name="menu" />
            节点树
        </button>
        <button type="button" class="btn btn-primary" @onclick="RefreshAsync" disabled="@_loading">
            <ContainerIcon Name="refresh" />
            @(_loading ? "刷新中…" : "刷新")
        </button>
    </div>
</div>

@if (_nodesLoaded && _nodes.Count == 0)
{
    <div class="state-card state-card-wide">
        <div class="state-icon"><ContainerIcon Name="server" Size="30" /></div>
        <h3>还没有节点</h3>
        <p class="muted">先到 <a href="/nodes/new">添加节点</a> 接入第一台 1Panel，再管理容器与 Compose 项目。</p>
        <div class="actions">
            <a class="btn btn-primary" href="/nodes/new">添加节点</a>
        </div>
    </div>
}
else
{
    <div class="container-workbench">
        <aside class="container-tree @(_treeOpen ? "is-open" : string.Empty)" aria-label="容器导航">
            <div class="container-tree-head">
                <span class="container-tree-title">节点与资源</span>
                <button type="button" class="btn btn-xs tree-close" @onclick="CloseTree" aria-label="收起节点树">
                    <ContainerIcon Name="close" />
                </button>
            </div>

            @if (!_nodesLoaded)
            {
                <div class="pf-tree-skeleton" aria-hidden="true">
                    @for (var i = 0; i < 7; i++)
                    {
                        <div class="pf-skeleton-line @(i % 2 == 0 ? "is-short" : string.Empty)"></div>
                    }
                </div>
            }
            else if (_nodesError is not null)
            {
                <div class="tree-error">
                    <p class="muted small">@_nodesError</p>
                    <button type="button" class="btn btn-xs" @onclick="RefreshAsync">重试</button>
                </div>
            }
            else
            {
                <NavTree Nodes="TreeNodes"
                         SelectedId="@_selectedTreeId"
                         SelectableBranches="true"
                         Searchable="true"
                         SearchPlaceholder="搜索节点或容器…"
                         EmptyText="暂无节点"
                         AriaLabel="容器导航树"
                         OnSelect="OnTreeSelectAsync"
                         OnToggle="OnTreeToggleAsync" />
            }
        </aside>

        @if (_treeOpen)
        {
            <div class="container-tree-backdrop" @onclick="CloseTree" aria-hidden="true"></div>
        }

        <section class="container-main">
            <div class="container-toolbar">
                <div class="container-tabs" role="tablist">
                    <button type="button"
                            class="container-tab @(_tab == "containers" ? "is-active" : string.Empty)"
                            role="tab"
                            aria-selected="@(_tab == "containers")"
                            @onclick="SwitchToContainersAsync">
                        <ContainerIcon Name="container" />
                        容器
                        @if (_containers is not null)
                        {
                            <span class="tab-count">@_containers.TotalMatched</span>
                        }
                    </button>
                    <button type="button"
                            class="container-tab @(_tab == "compose" ? "is-active" : string.Empty)"
                            role="tab"
                            aria-selected="@(_tab == "compose")"
                            @onclick="SwitchToComposeAsync">
                        <ContainerIcon Name="layers" />
                        Compose 项目
                        @if (_compose is not null)
                        {
                            <span class="tab-count">@_compose.TotalMatched</span>
                        }
                    </button>
                </div>

                <div class="scope-line">
                    <span class="scope-chip">
                        <ContainerIcon Name="server" Size="14" />
                        <span>@CurrentScopeLabel</span>
                        @if (NodeFilter is not null)
                        {
                            <button type="button" class="scope-clear" @onclick="SelectRootScopeAsync" aria-label="切换到全部节点">
                                <ContainerIcon Name="close" Size="12" />
                            </button>
                        }
                    </span>
                </div>
            </div>

            <div class="resource-toolbar container-filters">
                @if (_tab == "containers")
                {
                    <label class="toolbar-field">
                        <span class="toolbar-label">状态</span>
                        <select @bind="_stateFilter" @bind:after="ApplyFiltersAsync" disabled="@_loading">
                            <option value="all">全部</option>
                            <option value="running">运行中</option>
                            <option value="exited">已停止</option>
                            <option value="paused">已暂停</option>
                            <option value="created">已创建</option>
                            <option value="restarting">重启中</option>
                            <option value="dead">异常</option>
                        </select>
                    </label>
                }

                <label class="toolbar-field">
                    <span class="toolbar-label">搜索</span>
                    <input class="search-input"
                           placeholder="@(_tab == "containers" ? "容器名称…" : "Compose 项目名…")"
                           @bind="_searchInput"
                           @bind:event="oninput"
                           @onkeydown="OnSearchKeyDown" />
                </label>
                <button type="button" class="btn" @onclick="ApplyFiltersAsync" disabled="@_loading">
                    <ContainerIcon Name="search" />
                    搜索
                </button>
                @if (_tab == "compose")
                {
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="OpenComposeCreateAsync"
                            disabled="@(_loading || _operationBusy || NodeFilter is null)">
                        + 新建项目
                    </button>
                    @if (NodeFilter is null)
                    {
                        <span class="muted small">先在左侧选择节点后可新建项目</span>
                    }
                }
                <span class="muted small">每页 @PageSize 条</span>
            </div>

            @if (_tab == "containers")
            {
                @if (_error is not null)
                {
                    <div class="state-card state-card-error">
                        <div class="state-icon"><ContainerIcon Name="warning" Size="30" /></div>
                        <h3>容器加载失败</h3>
                        <p class="muted">@_error</p>
                        <div class="actions">
                            <button type="button" class="btn btn-primary" @onclick="RefreshAsync">重试</button>
                        </div>
                    </div>
                }
                else
                {
                    @if (_containers is not null)
                    {
                        @NodeResultStrip(_containers.Nodes, _containers.GeneratedAt)
                    }

                    <div class="batch-bar">
                        <span class="batch-count">已选 @_selected.Count 个容器</span>
                        <label class="toolbar-field">
                            <span class="toolbar-label">批量操作</span>
                            <select @bind="_batchOperation" disabled="@(_selected.Count == 0 || _operationBusy)">
                                <option value="container.start">启动</option>
                                <option value="container.stop">停止</option>
                                <option value="container.restart">重启</option>
                                <option value="container.pause">暂停</option>
                                <option value="container.unpause">恢复</option>
                                <option value="container.delete">删除</option>
                            </select>
                        </label>
                        <button type="button"
                                class="btn btn-danger"
                                disabled="@(_selected.Count == 0 || _operationBusy)"
                                @onclick="RunBatchOperationAsync">
                            执行批量操作（@_selected.Count）
                        </button>
                        <button type="button" class="btn" disabled="@(_selected.Count == 0)" @onclick="ClearSelection">清空选择</button>
                        <span class="muted small">批量按节点顺序执行，失败即停止；批量需要输入确认文本。</span>
                    </div>

                    @if (_containers is null)
                    {
                        <div class="pf-skeleton-table" aria-hidden="true">
                            @for (var i = 0; i < 6; i++)
                            {
                                <div class="pf-skeleton-row">
                                    <span class="pf-skeleton-cell"></span>
                                    <span class="pf-skeleton-cell"></span>
                                    <span class="pf-skeleton-cell"></span>
                                    <span class="pf-skeleton-cell is-short"></span>
                                    <span class="pf-skeleton-cell"></span>
                                    <span class="pf-skeleton-cell"></span>
                                </div>
                            }
                        </div>
                    }
                    else if (_containers.Rows.Count == 0)
                    {
                        <div class="state-card">
                            <div class="state-icon"><ContainerIcon Name="container" Size="30" /></div>
                            <h3>暂无容器</h3>
                            <p class="muted">当前筛选条件下没有容器。可以调整节点、状态或搜索关键字，或刷新重新采集。</p>
                            <div class="actions">
                                <button type="button" class="btn" @onclick="ResetFiltersAsync">清空筛选</button>
                                <button type="button" class="btn btn-primary" @onclick="RefreshAsync">
                                    <ContainerIcon Name="refresh" />
                                    刷新
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <ContainerTable Rows="_containers.Rows"
                                        SelectedKeys="_selected"
                                        ActiveKey="@_activeRowKey"
                                        OnSelect="OnSelectAsync"
                                        OnSelectAll="OnSelectAllAsync"
                                        OnDetail="OpenDetailAsync"
                                        OnLogs="OpenLogsAsync"
                                        OnTerminal="OpenTerminalAsync"
                                        OnOperate="OnOperateAsync" />

                        <div class="resource-pagination">
                            <span class="muted small">共 @_containers.TotalMatched 条 · 第 @_containers.Page/@Math.Max(_containers.TotalPages, 1) 页</span>
                            <div class="actions">
                                <button type="button" class="btn" @onclick="PreviousPageAsync" disabled="@(_loading || _page <= 1)">上一页</button>
                                <button type="button" class="btn" @onclick="NextPageAsync" disabled="@(_loading || _containers is null || _page >= Math.Max(_containers.TotalPages, 1))">下一页</button>
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                @if (_composeError is not null)
                {
                    <div class="state-card state-card-error">
                        <div class="state-icon"><ContainerIcon Name="warning" Size="30" /></div>
                        <h3>Compose 项目加载失败</h3>
                        <p class="muted">@_composeError</p>
                        <div class="actions">
                            <button type="button" class="btn btn-primary" @onclick="RefreshAsync">重试</button>
                        </div>
                    </div>
                }
                else
                {
                    @if (_compose is not null)
                    {
                        @NodeResultStrip(_compose.Nodes, _compose.GeneratedAt)
                    }

                    @if (_compose is null)
                    {
                        <div class="pf-skeleton-table" aria-hidden="true">
                            @for (var i = 0; i < 4; i++)
                            {
                                <div class="pf-skeleton-row is-compose">
                                    <span class="pf-skeleton-cell"></span>
                                    <span class="pf-skeleton-cell is-short"></span>
                                    <span class="pf-skeleton-cell"></span>
                                    <span class="pf-skeleton-cell"></span>
                                </div>
                            }
                        </div>
                    }
                    else if (_compose.Projects.Count == 0)
                    {
                        <div class="state-card">
                            <div class="state-icon"><ContainerIcon Name="layers" Size="30" /></div>
                            <h3>暂无 Compose 项目</h3>
                            <p class="muted">当前筛选条件下没有 Compose 项目。可以调整节点或搜索关键字，或刷新重新采集。</p>
                            <div class="actions">
                                <button type="button" class="btn" @onclick="ResetFiltersAsync">清空筛选</button>
                                <button type="button" class="btn btn-primary" @onclick="RefreshAsync">
                                    <ContainerIcon Name="refresh" />
                                    刷新
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <ComposeProjectTable Rows="_compose.Projects"
                                             ActiveKey="@_activeComposeKey"
                                             OnOperate="OnComposeOperateAsync"
                                             OnEdit="OpenComposeEditAsync"
                                             OnDelete="OpenComposeDeleteAsync" />
                    }
                }
            }
        </section>
    </div>
}

@if (_operationError is not null)
{
    <div class="alert alert-error operation-error">
        <span>@_operationError</span>
        <button type="button" class="btn btn-xs" @onclick="DismissOperationError">关闭</button>
    </div>
}

@if (_execution is not null)
{
    <div class="card operation-panel">
        <OperationResultView Execution="_execution" />
        <div class="actions">
            <button type="button" class="btn" @onclick="DismissExecution">关闭结果</button>
        </div>
    </div>
}

@* 浮层均为 position:fixed；全局 .page-enter 只做 opacity 动画、不创建 containing block，
   因此遮罩/抽屉始终相对视口定位（根因修复见 wwwroot/app.css 的 page-fade 注释）。 *@
<OperationConfirmDialog Preview="_preview" Busy="_operationBusy" OnConfirm="ConfirmOperationAsync" OnCancel="CancelOperation" />

@if (_detailRow is not null)
{
    <ContainerDetailDrawer Row="_detailRow"
                           Detail="_detail"
                           Loading="_detailLoading"
                           Error="@_detailError"
                           PanelUrl="@_detailPanelUrl"
                           OnRetry="LoadDetailAsync"
                           OnLogs="OpenLogsAsync"
                           OnTerminal="OpenTerminalAsync"
                           OnClose="CloseDetailAsync" />
}

@if (_logRow is not null)
{
    <ContainerLogPanel Row="_logRow"
                       Log="_log"
                       Loading="_logLoading"
                       Error="@_logError"
                       Tail="_logTail"
                       Since="@_logSince"
                       Timestamp="_logTimestamp"
                       Follow="_logFollow"
                       Live="_logLive"
                       Fullscreen="_logFullscreen"
                       OnRefresh="LoadLogsAsync"
                       OnToggleFollow="ToggleLogFollow"
                       OnToggleLive="ToggleLogLive"
                       OnToggleFullscreen="ToggleLogFullscreen"
                       OnClose="CloseLogs" />
}

<TerminalDrawer NodeId="@_terminalNodeId"
                ContainerName="@_terminalContainer"
                Visible="@(_terminalNodeId is not null)"
                OnClose="@CloseTerminal" />

@if (_composeEditorOpen)
{
    var editorNodeId = _composeEditorRow?.NodeId ?? NodeFilter;
    <ComposeEditorDialog Project="_composeEditorRow"
                         NodeName="@(editorNodeId is { } editorId ? ComposeDialogNodeName(editorId) : null)"
                         Busy="_operationBusy"
                         OnSubmit="SubmitComposeEditorAsync"
                         OnCancel="CloseComposeEditor" />
}

@if (_composeDeleteRow is not null)
{
    <ComposeDeleteDialog Project="_composeDeleteRow"
                         NodeName="@ComposeDialogNodeName(_composeDeleteRow.NodeId)"
                         Busy="_operationBusy"
                         OnSubmit="SubmitComposeDeleteAsync"
                         OnCancel="CloseComposeDelete" />
}

@code {
    private const int PageSize = 50;
    private const int TreePageSize = 200;
    private const string RootTreeId = "root";
    private const string StorageKey = "pf.tree.containers";

    private IReadOnlyList<NodeSummary> _nodes = [];
    private bool _nodesLoaded;
    private string? _nodesError;
    private string _nodeFilterValue = string.Empty;

    private string _tab = "containers";
    private string _stateFilter = "all";
    private string? _searchInput;
    private string? _nameFilter;
    private int _page = 1;
    private bool _loading;
    private string? _error;
    private string? _composeError;

    private ContainerListResult? _containers;
    private ComposeListResult? _compose;

    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private string _batchOperation = "container.start";

    private OperationPreview? _preview;
    private OperationExecution? _execution;
    private bool _operationBusy;
    private string? _operationError;

    private ContainerRow? _detailRow;
    private ContainerDetail? _detail;
    private bool _detailLoading;
    private string? _detailError;
    private string? _detailPanelUrl;

    private ContainerRow? _logRow;
    private ContainerLogView? _log;
    private bool _logLoading;
    private string? _logError;
    private int _logTail = 200;
    private string _logSince = "all";
    private bool _logTimestamp;

    // 日志浮层交互状态：全屏、实时跟踪（保持到底部）、实时刷新（2 秒轮询）。
    private bool _logFullscreen;
    private bool _logFollow;
    private bool _logLive;
    private bool _logRequestInFlight;
    private CancellationTokenSource? _logLiveCts;

    // 终端抽屉目标；为 null 表示抽屉关闭。
    private Guid? _terminalNodeId;
    private string? _terminalContainer;

    // Compose 新建/编辑与删除对话框状态（真正执行仍走预览 + OperationConfirmDialog）。
    private bool _composeEditorOpen;
    private ComposeProjectRow? _composeEditorRow;
    private ComposeProjectRow? _composeDeleteRow;

    private CancellationTokenSource? _cts;

    private bool _initialized;
    private bool _interactive;
    private Guid? _appliedRouteNodeId;
    private string? _appliedRouteContainer;

    private bool _treeOpen;
    private string? _selectedTreeId = RootTreeId;
    private readonly HashSet<string> _expandRequest = new(StringComparer.Ordinal);
    private readonly HashSet<string> _treeLoading = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _treeErrors = new(StringComparer.Ordinal);
    private readonly Dictionary<Guid, IReadOnlyList<NavTreeNode>> _nodeContainers = new();
    private readonly HashSet<Guid> _nodeContainersLoaded = new();
    private readonly Dictionary<Guid, IReadOnlyList<NavTreeNode>> _nodeCompose = new();
    private readonly HashSet<Guid> _nodeComposeLoaded = new();

    private string? _activeRowKey;
    private string? _activeComposeKey;
    private string? _urlSelectionName;

    [Parameter, EditorRequired]
    public Guid? NodeId { get; set; }

    [Parameter]
    public string? Container { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        _expandRequest.Add(RootTreeId);
        await LoadNodesAsync();

        if (NodeId is { } routeNodeId && _nodes.Any(node => node.Id.Value == routeNodeId))
        {
            _nodeFilterValue = routeNodeId.ToString();
            _selectedTreeId = NodeKey(routeNodeId);
            _expandRequest.Add(NodeKey(routeNodeId));
        }

        _initialized = true;
        _appliedRouteNodeId = NodeId;
        _appliedRouteContainer = Container;

        if (_nodesLoaded && _nodes.Count > 0)
        {
            await LoadAsync();
            if (!string.IsNullOrWhiteSpace(Container))
            {
                await LocateContainerAsync(Container.Trim());
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized)
        {
            return;
        }

        if (NodeId == _appliedRouteNodeId &&
            string.Equals(Container, _appliedRouteContainer, StringComparison.Ordinal))
        {
            return;
        }

        _appliedRouteNodeId = NodeId;
        _appliedRouteContainer = Container;

        if (NodeId is { } nodeId && _nodes.Any(node => node.Id.Value == nodeId))
        {
            _nodeFilterValue = nodeId.ToString();
            _selectedTreeId = NodeKey(nodeId);
            _expandRequest.Add(NodeKey(nodeId));
            await EnsureNodeContainersAsync(nodeId);
        }
        else
        {
            _nodeFilterValue = string.Empty;
            _selectedTreeId = RootTreeId;
            _expandRequest.Add(RootTreeId);
        }

        _page = 1;
        _activeRowKey = null;
        _activeComposeKey = null;
        _urlSelectionName = null;
        await LoadAsync();

        if (!string.IsNullOrWhiteSpace(Container))
        {
            await LocateContainerAsync(Container.Trim());
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_expandRequest.Count > 0)
        {
            _expandRequest.Clear();
        }

        if (!firstRender)
        {
            return;
        }

        _interactive = RendererInfo.IsInteractive;
        if (_interactive)
        {
            var changed = await RestoreSelectionAsync();
            if (changed)
            {
                StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        StopLogPolling();
        _cts?.Dispose();
    }

    private CancellationToken Token => _cts?.Token ?? CancellationToken.None;

    private Guid? NodeFilter => Guid.TryParse(_nodeFilterValue, out var id) ? id : null;

    private string CurrentScopeLabel
    {
        get
        {
            if (NodeFilter is not { } nodeId)
            {
                return "全部节点";
            }

            return _nodes.FirstOrDefault(node => node.Id.Value == nodeId)?.Name ?? "已选节点";
        }
    }

    private async Task LoadNodesAsync()
    {
        _nodesError = null;
        try
        {
            _nodes = await NodeService.ListAsync(Token);
            _nodesLoaded = true;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            _nodes = [];
            _nodesLoaded = false;
            _nodesError = "节点列表加载失败：" + exception.Message;
            _error = _nodesError;
            _composeError = _nodesError;
        }
    }

    private async Task LoadAsync()
    {
        if (_tab == "containers")
        {
            await LoadContainersAsync();
        }
        else
        {
            await LoadComposeAsync();
        }
    }

    private async Task LoadContainersAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _containers = await ContainerService.ListAsync(BuildQuery(), Token);
            PruneSelection(_containers.Rows);
        }
        catch (OperationCanceledException)
        {
        }
        catch (ContainerNodeNotFoundException exception)
        {
            _error = exception.Message;
        }
        catch (Exception exception)
        {
            _error = "加载容器失败：" + exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadComposeAsync()
    {
        _loading = true;
        _composeError = null;
        try
        {
            _compose = await ContainerService.ListComposeAsync(BuildQuery(), Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (ContainerNodeNotFoundException exception)
        {
            _composeError = exception.Message;
        }
        catch (Exception exception)
        {
            _composeError = "加载 Compose 项目失败：" + exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private ContainerQuery BuildQuery() =>
        new(NodeFilter, string.IsNullOrWhiteSpace(_nameFilter) ? null : _nameFilter, _stateFilter, "name", "ascending", _page, PageSize);

    private async Task RefreshAsync()
    {
        _selected.Clear();
        _activeRowKey = null;
        _activeComposeKey = null;
        _urlSelectionName = null;
        _nodeContainers.Clear();
        _nodeContainersLoaded.Clear();
        _nodeCompose.Clear();
        _nodeComposeLoaded.Clear();
        _treeErrors.Clear();
        _error = null;
        _composeError = null;

        await LoadNodesAsync();
        if (NodeFilter is { } nodeId)
        {
            await EnsureNodeContainersAsync(nodeId);
            await EnsureNodeComposeAsync(nodeId);
        }

        await LoadAsync();
        await SyncUrlAsync();
    }

    private async Task SwitchTabAsync(string tab)
    {
        if (_tab == tab)
        {
            return;
        }

        _tab = tab;
        _page = 1;
        _preview = null;
        _urlSelectionName = null;
        _treeOpen = false;
        if (tab == "compose")
        {
            await LoadComposeAsync();
        }
        else
        {
            await LoadContainersAsync();
        }

        await PersistSelectionAsync();
        await SyncUrlAsync();
    }

    private Task SwitchToContainersAsync() => SwitchTabAsync("containers");

    private Task SwitchToComposeAsync() => SwitchTabAsync("compose");

    private async Task ApplyFiltersAsync()
    {
        _page = 1;
        _nameFilter = string.IsNullOrWhiteSpace(_searchInput) ? null : _searchInput.Trim();
