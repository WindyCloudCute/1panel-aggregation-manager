    private string? BuildPanelUrl(Guid nodeId, string section)
    {
        var node = _nodes.FirstOrDefault(item => item.Id.Value == nodeId);
        if (node is null)
        {
            return null;
        }

        var root = node.BaseUrl.AbsoluteUri.TrimEnd('/');
        var entrance = string.IsNullOrWhiteSpace(node.SecurityEntrance)
            ? string.Empty
            : "/" + node.SecurityEntrance.Trim('/');
        return root + entrance + "/" + section;
    }

    // ---------- 左树 ----------

    private void OpenTree() => _treeOpen = true;

    private void CloseTree() => _treeOpen = false;

    private IReadOnlyList<NavTreeNode> TreeNodes
    {
        get
        {
            var nodeItems = new List<NavTreeNode>(_nodes.Count);
            foreach (var node in _nodes)
            {
                nodeItems.Add(BuildNodeTreeNode(node));
            }

            var online = _nodes.Count(node => node.Health == NodeHealth.Online);
            var badgeClass = online == _nodes.Count && _nodes.Count > 0
                ? "badge-ok"
                : online > 0
                    ? "badge-warn"
                    : "badge-error";

            return
            [
                new NavTreeNode
                {
                    Id = RootTreeId,
                    Label = "全部节点",
                    Hint = "共 " + _nodes.Count + " 个节点",
                    BadgeText = online + " 在线",
                    BadgeClass = badgeClass,
                    Kind = NavTreeNodeKind.Branch,
                    ChildrenLoaded = true,
                    DefaultExpanded = _expandRequest.Contains(RootTreeId),
                    Children = nodeItems
                }
            ];
        }
    }

    private NavTreeNode BuildNodeTreeNode(NodeSummary node)
    {
        var nodeId = node.Id.Value;
        var key = NodeKey(nodeId);
        var containersLoaded = _nodeContainersLoaded.Contains(nodeId);
        var composeLoaded = _nodeComposeLoaded.Contains(nodeId);
        var containerLeaves = _nodeContainers.TryGetValue(nodeId, out var mappedContainers) ? mappedContainers : [];
        var composeLeaves = _nodeCompose.TryGetValue(nodeId, out var mappedCompose) ? mappedCompose : [];
        var containerGroupId = key + ":containers";
        var composeGroupId = key + ":compose";

        var groups = new List<NavTreeNode>(2)
        {
            new()
            {
                Id = containerGroupId,
                Label = "容器",
                Hint = containersLoaded ? containerLeaves.Count + " 个" : "展开以加载",
                Kind = NavTreeNodeKind.Branch,
                ChildrenLoaded = containersLoaded,
                IsLoading = _treeLoading.Contains(containerGroupId),
                Error = ErrorFor(containerGroupId),
                DefaultExpanded = _expandRequest.Contains(containerGroupId),
                Children = containerLeaves
            },
            new()
            {
                Id = composeGroupId,
                Label = "Compose 项目",
                Hint = composeLoaded ? composeLeaves.Count + " 个" : "展开以加载",
                Kind = NavTreeNodeKind.Branch,
                ChildrenLoaded = composeLoaded,
                IsLoading = _treeLoading.Contains(composeGroupId),
                Error = ErrorFor(composeGroupId),
                DefaultExpanded = _expandRequest.Contains(composeGroupId),
                Children = composeLeaves
            }
        };

        return new NavTreeNode
        {
            Id = key,
            Label = node.Name,
            Hint = BuildNodeHint(node),
            BadgeText = HealthText(node.Health),
            BadgeClass = HealthClass(node.Health),
            Kind = NavTreeNodeKind.Branch,
            IsDisabled = !node.IsEnabled,
            IsLoading = _treeLoading.Contains(key),
            Error = ErrorFor(key),
            ChildrenLoaded = containersLoaded,
            DefaultExpanded = _expandRequest.Contains(key),
            Children = groups
        };
    }

    private static string BuildNodeHint(NodeSummary node)
    {
        var parts = new List<string>(2);
        if (!string.IsNullOrWhiteSpace(node.PanelVersion))
        {
            parts.Add("v" + node.PanelVersion);
        }

        if (!string.IsNullOrWhiteSpace(node.HealthMessage))
        {
            parts.Add(node.HealthMessage);
        }

        if (parts.Count == 0)
        {
            parts.Add(node.BaseUrl.Authority);
        }

        if (!node.IsEnabled)
        {
            parts.Add("已停用");
        }

        return string.Join(" · ", parts);
    }

    private static string HealthText(NodeHealth health) => health switch
    {
        NodeHealth.Online => "在线",
        NodeHealth.Degraded => "降级",
        NodeHealth.Offline => "离线",
        _ => "未知"
    };

    private static string HealthClass(NodeHealth health) => health switch
    {
        NodeHealth.Online => "badge-ok",
        NodeHealth.Degraded => "badge-warn",
        NodeHealth.Offline => "badge-error",
        _ => "badge-unknown"
    };

    private static NavTreeNode BuildContainerLeaf(ContainerRow row) => new()
    {
        Id = ContainerLeafId(row.NodeId, row.Name),
        Label = row.Name,
        Hint = string.IsNullOrWhiteSpace(row.RunTime) ? row.Image : row.RunTime,
        BadgeText = ContainerStateText(row.State),
        BadgeClass = ContainerStateClass(row.State),
        Kind = NavTreeNodeKind.Leaf
    };

    private static NavTreeNode BuildComposeLeaf(ComposeProjectRow project) => new()
    {
        Id = ComposeLeafId(project.NodeId, project.Name),
        Label = project.Name,
        Hint = project.Path,
        BadgeText = project.RunningCount + "/" + project.ContainerCount,
        BadgeClass = ComposeStateClass(project),
        Kind = NavTreeNodeKind.Leaf
    };

    private static string ContainerStateText(string? state) => ContainerStates.Normalize(state) switch
    {
        "running" => "运行中",
        "exited" => "已停止",
        "paused" => "已暂停",
        "restarting" => "重启中",
        "created" => "已创建",
        "dead" => "异常",
        "removing" => "删除中",
        _ => string.IsNullOrWhiteSpace(state) ? "未知" : state
    };

    private static string ContainerStateClass(string? state) => ContainerStates.Normalize(state) switch
    {
        "running" => "badge-ok",
        "paused" or "restarting" => "badge-warn",
        "dead" or "removing" => "badge-error",
        _ => "badge-unknown"
    };

    private static string ComposeStateClass(ComposeProjectRow project) =>
        project.ContainerCount == 0
            ? "badge-unknown"
            : project.RunningCount == project.ContainerCount
                ? "badge-ok"
                : project.RunningCount > 0
                    ? "badge-warn"
                    : "badge-unknown";

    private string? ErrorFor(string id) => _treeErrors.TryGetValue(id, out var message) ? message : null;

    private async Task OnTreeSelectAsync(NavTreeNode node)
    {
        _treeOpen = false;
        _selectedTreeId = node.Id;

        if (string.Equals(node.Id, RootTreeId, StringComparison.Ordinal))
        {
            await SelectScopeAsync(null);
            return;
        }

        if (TryParseNodeTreeId(node.Id, out var nodeId, out var group))
        {
            if (string.Equals(group, "containers", StringComparison.Ordinal))
            {
                _tab = "containers";
                await SelectScopeAsync(nodeId);
                await EnsureNodeContainersAsync(nodeId);
            }
            else if (string.Equals(group, "compose", StringComparison.Ordinal))
            {
                _tab = "compose";
                await SelectScopeAsync(nodeId);
                await EnsureNodeComposeAsync(nodeId);
            }
            else
            {
                await SelectScopeAsync(nodeId);
                await EnsureNodeContainersAsync(nodeId);
            }

            return;
        }

        if (TryParseLeafId(node.Id, out var kind, out var leafNodeId, out var name))
        {
            if (string.Equals(kind, "container", StringComparison.Ordinal))
            {
                await SelectContainerLeafAsync(leafNodeId, name);
            }
            else
            {
                await SelectComposeLeafAsync(leafNodeId, name);
            }
        }
    }

    private async Task OnTreeToggleAsync(NavTreeNode node)
    {
        if (!TryParseNodeTreeId(node.Id, out var nodeId, out var group))
        {
            return;
        }

        if (string.Equals(group, "containers", StringComparison.Ordinal) || group is null)
        {
            await EnsureNodeContainersAsync(nodeId);
        }
        else if (string.Equals(group, "compose", StringComparison.Ordinal))
        {
            await EnsureNodeComposeAsync(nodeId);
        }
    }

