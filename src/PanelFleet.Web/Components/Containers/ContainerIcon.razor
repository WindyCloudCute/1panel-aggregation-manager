@* 容器页内联 SVG 图标：统一线性风格，不引入图标库、不使用 emoji。 *@
<svg class="pf-icon" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @((MarkupString)PathMarkup)
</svg>

@code {
    private static readonly Dictionary<string, string> Paths = new(StringComparer.Ordinal)
    {
        ["refresh"] = "<path d=\"M21 12a9 9 0 1 1-2.64-6.36\"/><polyline points=\"21 3 21 9 15 9\"/>",
        ["search"] = "<circle cx=\"11\" cy=\"11\" r=\"7\"/><line x1=\"21\" y1=\"21\" x2=\"16.7\" y2=\"16.7\"/>",
        ["menu"] = "<line x1=\"4\" y1=\"6\" x2=\"20\" y2=\"6\"/><line x1=\"4\" y1=\"12\" x2=\"20\" y2=\"12\"/><line x1=\"4\" y1=\"18\" x2=\"20\" y2=\"18\"/>",
        ["close"] = "<line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"/><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"/>",
        ["container"] = "<path d=\"M21 8l-9-5-9 5v8l9 5 9-5z\"/><path d=\"M3 8l9 5 9-5\"/><path d=\"M12 13v9\"/>",
        ["layers"] = "<path d=\"M12 3l9 5-9 5-9-5z\"/><path d=\"M3 13l9 5 9-5\"/>",
        ["warning"] = "<path d=\"M12 3l9 16H3z\"/><path d=\"M12 9v4\"/><path d=\"M12 17h.01\"/>",
        ["terminal"] = "<rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M7 9l3 3-3 3\"/><path d=\"M13 15h4\"/>",
        ["logs"] = "<path d=\"M5 3h9l5 5v13H5z\"/><path d=\"M14 3v5h5\"/><path d=\"M8 13h8\"/><path d=\"M8 17h6\"/>",
        ["server"] = "<rect x=\"3\" y=\"4\" width=\"18\" height=\"6\" rx=\"2\"/><rect x=\"3\" y=\"14\" width=\"18\" height=\"6\" rx=\"2\"/><path d=\"M7 7h.01\"/><path d=\"M7 17h.01\"/>",
        ["external"] = "<path d=\"M14 4h6v6\"/><path d=\"M20 4l-9 9\"/><path d=\"M19 13v6H5V5h6\"/>",
        ["dot"] = "<circle cx=\"12\" cy=\"12\" r=\"3\"/>"
    };

    /// <summary>图标名称：refresh/search/menu/close/container/layers/warning/terminal/logs/server/external/dot。</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = "dot";

    /// <summary>图标边长（px）。</summary>
    [Parameter]
    public int Size { get; set; } = 16;

    /// <summary>线宽。</summary>
    [Parameter]
    public double StrokeWidth { get; set; } = 1.8;

    private string PathMarkup => Paths.TryGetValue(Name, out var markup) ? markup : Paths["dot"];
}
