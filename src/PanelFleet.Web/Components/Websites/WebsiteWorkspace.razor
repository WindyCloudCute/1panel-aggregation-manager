    private static string NodeTreeId(Guid nodeId) => $"node:{nodeId:N}";

    private static string GroupTreeId(Guid nodeId, long groupId) => $"group:{nodeId:N}:{groupId}";

    private static string SiteTreeId(Guid nodeId, long websiteId) => $"site:{nodeId:N}:{websiteId}";

    private static bool TryParseNodeId(string id, out Guid nodeId)
    {
        nodeId = Guid.Empty;
        if (!id.StartsWith("node:", StringComparison.Ordinal))
        {
            return false;
        }

        return Guid.TryParse(id["node:".Length..], out nodeId);
    }

    private static bool TryParseGroupId(string id, out Guid nodeId, out long groupId)
    {
        nodeId = Guid.Empty;
        groupId = 0;
        if (!id.StartsWith("group:", StringComparison.Ordinal))
        {
            return false;
        }

        var parts = id.Split(':');
        return parts.Length == 3
            && Guid.TryParse(parts[1], out nodeId)
            && long.TryParse(parts[2], out groupId);
    }

    private static bool TryParseSiteId(string id, out Guid nodeId, out long websiteId)
    {
        nodeId = Guid.Empty;
        websiteId = 0;
        if (!id.StartsWith("site:", StringComparison.Ordinal))
        {
            return false;
        }

        var parts = id.Split(':');
        return parts.Length == 3
            && Guid.TryParse(parts[1], out nodeId)
            && long.TryParse(parts[2], out websiteId);
    }

    private bool IsValidTreeId(string id)
    {
        if (id == RootId)
        {
            return true;
        }

        if (TryParseNodeId(id, out var nodeId) || TryParseGroupId(id, out nodeId, out _) || TryParseSiteId(id, out nodeId, out _))
        {
            return IsEnabledNode(nodeId);
        }

        return false;
    }

    private static string StatusBadgeClass(string? status) => status?.ToLowerInvariant() switch
    {
        "running" => "badge-ok",
        "stopped" => "badge-unknown",
        "error" => "badge-error",
        _ => "badge-unknown"
    };

    private async Task SavePreferenceAsync()
    {
        var payload = JsonSerializer.Serialize(
            new Preference(_selectedTreeId ?? RootId, _scopeNodeId?.ToString()),
            PreferenceJsonOptions);
        await InvokeJsAsync("localStorage.setItem", PreferenceKey, payload);
    }

    private async Task<string?> ReadPreferenceAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", PreferenceKey);
            if (string.IsNullOrWhiteSpace(raw))
            {
                return null;
            }

            var parsed = JsonSerializer.Deserialize<Preference>(raw, PreferenceJsonOptions);
            return string.IsNullOrWhiteSpace(parsed?.TreeId) ? null : parsed!.TreeId;
        }
        catch (Exception)
        {
            return null;
        }
    }

    private async Task UpdateUrlAsync(Guid? nodeId, long? websiteId)
    {
        var query = new List<string>();
        if (nodeId is Guid id)
        {
            query.Add("nodeId=" + id.ToString("N"));
        }

        if (websiteId is long website)
        {
            query.Add("id=" + website);
        }

        var relative = "/websites" + (query.Count > 0 ? "?" + string.Join("&", query) : string.Empty);
        // 使用相对地址即可保留当前部署的 PathBase，history.replaceState 不会触发导航。
        await InvokeJsAsync("history.replaceState", null, string.Empty, relative);
    }

    private async Task InvokeJsAsync(string identifier, params object?[] args)
    {
        try
        {
            await JS.InvokeVoidAsync(identifier, args);
        }
        catch (Exception)
        {
            // 预渲染或 JS 不可用时静默降级：树/深链仍可用，仅失去记忆能力。
        }
    }

    private void _treeErrorReset()
    {
    }

