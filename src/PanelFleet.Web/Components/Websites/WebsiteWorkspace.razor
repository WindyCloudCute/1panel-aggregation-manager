    private async Task PreviewAsync(string kind, JsonObject parameters, Guid nodeId)
    {
        _busy = true;
        _operationError = null;
        _execution = null;
        _preview = null;
        try
        {
            _preview = await Operations.PreviewAsync(
                new OperationInvocation(kind, [new NodeId(nodeId)], parameters),
                _actor ?? ActorInfo.System,
                default);
        }
        catch (OperationValidationException exception)
        {
            _operationError = exception.Message;
        }
        catch (OperationNotSupportedException exception)
        {
            _operationError = exception.Message;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            _operationError = "预览失败：" + exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExecuteAsync(string? typedConfirmation)
    {
        if (_preview is not { } preview)
        {
            return;
        }

        _busy = true;
        _operationError = null;
        try
        {
            _execution = await Operations.ExecuteAsync(
                preview.TokenId,
                typedConfirmation,
                _actor ?? ActorInfo.System,
                default);
            _preview = null;
            await LoadAsync();
            if (_drawerOpen)
            {
                await RefreshDetailAsync();
            }

            if (_scopeNodeId is Guid nodeId && _treeNodes.Count > 0)
            {
                await LoadNodeChildrenAsync(nodeId);
            }
        }
        catch (OperationConfirmationException exception)
        {
            _operationError = exception.Message;
        }
        catch (OperationValidationException exception)
        {
            _operationError = exception.Message;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            _operationError = "执行失败：" + exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

