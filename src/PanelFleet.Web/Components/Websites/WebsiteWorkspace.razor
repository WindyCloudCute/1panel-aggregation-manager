    private void UpdateTreeNode(string id, Func<NavTreeNode, NavTreeNode> update)
    {
        _treeNodes = UpdateNodes(_treeNodes, id, update);
    }

    private static IReadOnlyList<NavTreeNode> UpdateNodes(
        IReadOnlyList<NavTreeNode> nodes,
        string id,
        Func<NavTreeNode, NavTreeNode> update)
    {
        var changed = false;
        var result = new List<NavTreeNode>(nodes.Count);
        foreach (var node in nodes)
        {
            if (node.Id == id)
            {
                result.Add(update(node));
                changed = true;
                continue;
            }

            if (node.Children.Count > 0)
            {
                var children = UpdateNodes(node.Children, id, update);
                if (!ReferenceEquals(children, node.Children))
                {
                    result.Add(node with { Children = children });
                    changed = true;
                    continue;
                }
            }

            result.Add(node);
        }

        return changed ? result : nodes;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (_scopeNodeId is Guid nodeId)
            {
                await LoadNodeScopeAsync(nodeId);
            }
            else
            {
                await LoadAggregateAsync();
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            _view = null;
            _error = "加载网站列表失败：" + exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadNodeScopeAsync(Guid nodeId)
    {
        if (_ungroupedOnly)
        {
            var fetch = await WebsiteService.ListAsync(new WebsiteQuery(nodeId, null, _search, 1, TreeFetchPageSize), default);
            var rows = fetch.Rows
                .Where(row => fetch.Groups.All(group => group.Id != row.GroupId))
                .ToList();
            var totalPages = Math.Max(1, (int)Math.Ceiling(rows.Count / (double)PageSize));
            var page = Math.Clamp(_page, 1, totalPages);
            _view = new WebsiteView(
                rows.Skip((page - 1) * PageSize).Take(PageSize).ToArray(),
                rows.Count,
                page,
                PageSize,
                totalPages,
                fetch.Groups,
                false,
                fetch.Warnings,
                fetch.GeneratedAt);
            _groups = fetch.Groups;
            _page = page;
            return;
        }

        var result = await WebsiteService.ListAsync(
            new WebsiteQuery(nodeId, _scopeGroupId, _search, _page, PageSize),
            default);
        _view = new WebsiteView(
            result.Rows,
            result.TotalMatched,
            result.Page,
            result.PageSize,
            result.TotalPages,
            result.Groups,
            result.Truncated,
            result.Warnings,
            result.GeneratedAt);
        _groups = result.Groups;
        _page = result.Page;
    }

    private async Task LoadAggregateAsync()
    {
        if (_enabledNodes.Count == 0)
        {
            _view = null;
            return;
        }

        var loads = _enabledNodes.Select(async node =>
        {
            try
            {
                var result = await WebsiteService.ListAsync(new WebsiteQuery(node.Id.Value, null, _search, 1, TreeFetchPageSize), default);
                return new NodeLoad(node, result, null);
            }
            catch (Exception exception)
            {
                return new NodeLoad(node, null, exception.Message);
            }
        });

        var results = await Task.WhenAll(loads);
        var rows = new List<WebsiteRow>();
        var warnings = new List<string>();
        var truncated = false;
        var groups = new List<WebsiteGroupInfo>();
        foreach (var load in results)
        {
            if (load.Result is null)
            {
                warnings.Add($"节点 {load.Node.Name} 读取失败：{load.Error}");
                continue;
            }

            rows.AddRange(load.Result.Rows);
            truncated |= load.Result.Truncated || load.Result.TotalMatched > load.Result.Rows.Count;
            groups.AddRange(load.Result.Groups);
            foreach (var warning in load.Result.Warnings)
            {
                warnings.Add($"{load.Node.Name}：{warning}");
            }
        }

        IEnumerable<WebsiteRow> filtered = rows;
        if (!string.IsNullOrWhiteSpace(_search))
        {
            filtered = filtered.Where(row => Contains(row.PrimaryDomain)
                || Contains(row.Alias)
                || Contains(row.Remark));
        }

        var ordered = filtered
            .OrderByDescending(row => row.Favorite)
            .ThenBy(row => row.PrimaryDomain, StringComparer.OrdinalIgnoreCase)
            .ToList();
        var totalPages = Math.Max(1, (int)Math.Ceiling(ordered.Count / (double)PageSize));
        var page = Math.Clamp(_page, 1, totalPages);
        _view = new WebsiteView(
            ordered.Skip((page - 1) * PageSize).Take(PageSize).ToArray(),
            ordered.Count,
            page,
            PageSize,
            totalPages,
            groups.DistinctBy(group => (group.Id, group.Name)).ToArray(),
            truncated || ordered.Count > WebsiteService.MaxRows,
            warnings.Distinct(StringComparer.Ordinal).ToArray(),
            DateTimeOffset.UtcNow);
        _page = page;

        bool Contains(string? value) => !string.IsNullOrWhiteSpace(value)
            && value.Contains(_search!, StringComparison.OrdinalIgnoreCase);
    }

