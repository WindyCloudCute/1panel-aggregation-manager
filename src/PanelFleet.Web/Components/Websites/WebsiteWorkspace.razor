        IReadOnlyList<WebsiteRow> Rows,
        int TotalMatched,
        int Page,
        int PageSize,
        int TotalPages,
        IReadOnlyList<WebsiteGroupInfo> Groups,
        bool Truncated,
        IReadOnlyList<string> Warnings,
        DateTimeOffset GeneratedAt);

    private sealed record NodeLoad(NodeSummary Node, WebsiteListResult? Result, string? Error);

    private sealed record Preference(string TreeId, string? NodeId);
