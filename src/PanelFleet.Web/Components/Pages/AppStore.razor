    private int StoreTotalPages => Math.Max(1, (int)Math.Ceiling(_storeTotal / (double)StorePageSize));

    private int InstalledTotalPages => Math.Max(1, (int)Math.Ceiling(_installedTotal / (double)InstalledPageSize));

    private int UpgradeSelectedCount =>
        _upgradeRows.Count(row => row.CanSelect && _upgradeSelected.Contains(row.Key));

    private int UpgradeSelectedNodeCount => _upgradeRows
        .Where(row => row.CanSelect && _upgradeSelected.Contains(row.Key))
