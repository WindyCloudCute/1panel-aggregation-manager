    private async Task StartInstallAsync(AppInstallFormResult form)
    {
        if (_installNodeId is { } targetNode && _nodeId?.Value != targetNode)
        {
            SelectNode(targetNode);
        }

        if (_nodeId is null)
        {
            _operationError = "请先选择目标节点。";
            return;
        }

        var parameters = new JsonObject
        {
            ["appDetailId"] = form.AppDetailId,
            ["name"] = form.Name,
            ["appKey"] = form.AppKey,
            ["appName"] = form.AppName,
            ["version"] = form.Version,
            ["params"] = form.Parameters,
            ["cpuQuota"] = form.CpuQuota,
            ["memoryLimit"] = form.MemoryLimit,
            ["memoryUnit"] = form.MemoryUnit,
            ["allowPort"] = form.AllowPort,
            ["pullImage"] = form.PullImage,
            ["editCompose"] = form.EditCompose,
            ["restartPolicy"] = form.RestartPolicy
        };

        AddIfNotNull(parameters, "containerName", form.ContainerName);
        AddIfNotNull(parameters, "specifyIP", form.SpecifyIp);
        AddIfNotNull(parameters, "dockerCompose", form.DockerCompose);

        await PreviewAsync("app.install", parameters);
    }

    private Task OpenDetailParamsAsync() =>
        _installedDetailItem is { } app ? OpenParamsAsync(app) : Task.CompletedTask;

    private Task OpenDetailUpgradeAsync() =>
        _installedDetailItem is { } app ? OpenUpgradeAsync(app) : Task.CompletedTask;

    private Task OpenDetailUninstallAsync() =>
        _installedDetailItem is { } app ? OpenUninstallAsync(app) : Task.CompletedTask;

    private async Task OpenInstalledDetailAsync(InstalledAppItem app)
    {
        if (_nodeId is not { } nodeId)
        {
            return;
        }

        _installedDetailItem = app;
        _installedDetail = null;
        _installedDetailError = null;
        _installedDetailLoading = true;
        try
        {
            _installedDetail = await Store.GetInstalledAsync(nodeId, app.Id, default);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            _installedDetailError = exception.Message;
        }
        finally
        {
            _installedDetailLoading = false;
        }
    }

    private async Task OpenInstalledDetailByIdAsync(long installId)
    {
        var app = _installedItems.FirstOrDefault(item => item.Id == installId);
        if (app is null && _nodeId is { } nodeId)
        {
            app = _treeApps.TryGetValue(nodeId.Value, out var apps)
                ? apps.FirstOrDefault(item => item.Id == installId)
                : null;
        }

        if (app is not null)
        {
            await OpenInstalledDetailAsync(app);
            return;
        }

        if (_nodeId is not { } fallbackNode)
        {
            return;
        }

        _installedDetailItem = null;
        _installedDetail = null;
        _installedDetailError = null;
        _installedDetailLoading = true;
        try
        {
            var detail = await Store.GetInstalledAsync(fallbackNode, installId, default);
            _installedDetail = detail;
            _installedDetailItem = ToInstalledItem(detail);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            _installedDetailError = exception.Message;
        }
        finally
        {
            _installedDetailLoading = false;
        }
    }

    private void CloseInstalledDetail()
    {
        _installedDetail = null;
        _installedDetailItem = null;
        _installedDetailError = null;
    }

    private Task OpenUpgradeAsync(InstalledAppItem app) =>
        OpenUpgradeForAsync(_nodeId?.Value, CurrentNode?.Name, app, knownLatest: null);

    private Task UpgradeCandidateAsync(AppUpgradeCandidate row) =>
        OpenUpgradeForAsync(row.NodeId, row.NodeName, row.App, row.Latest);

    private async Task OpenUpgradeForAsync(Guid? nodeId, string? nodeName, InstalledAppItem app, AppUpdateVersion? knownLatest)
    {
        if (nodeId is null)
        {
            return;
        }

        _upgradeNodeId = nodeId;
        _upgradeNodeName = nodeName ?? NodeNameOf(nodeId.Value);
        _upgradeTarget = app;
        _upgradeVersions = [];
        _upgradeVersion = null;
        _upgradeError = null;
        _upgradeBackup = true;
        _upgradePullImage = true;
        _upgradeDeleteImage = false;

        if (knownLatest is not null)
        {
            _upgradeVersions = [knownLatest];
            _upgradeVersion = knownLatest;
            return;
        }

        _upgradeLoading = true;
        try
        {
            _upgradeVersions = await Store.GetUpdateVersionsAsync(new NodeId(nodeId.Value), app.Id, default);
            _upgradeVersion = _upgradeVersions.LastOrDefault();
            if (_upgradeVersions.Count == 0)
            {
                _upgradeError = "当前没有可用的升级版本。";
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            _upgradeError = "查询升级版本失败：" + exception.Message;
        }
        finally
        {
            _upgradeLoading = false;
        }
    }

    /// <summary>聚合所有启用节点的可升级应用（每个节点只取第一页，最多 100 个）。</summary>
    private async Task LoadUpgradeCandidatesAsync()
    {
        _upgradeTabLoading = true;
        _upgradeTabError = null;
        var rows = new List<AppUpgradeCandidate>();
        var nodeErrors = new List<string>();
        try
        {
            foreach (var node in EnabledNodes)
            {
                try
                {
                    var page = await Store.SearchInstalledAsync(node.Id, null, null, false, true, 1, 100, default);
                    foreach (var app in page.Items.Where(item => item.CanUpdate))
                    {
                        try
                        {
                            var versions = await Store.GetUpdateVersionsAsync(node.Id, app.Id, default);
                            rows.Add(new AppUpgradeCandidate(node.Id.Value, node.Name, app, versions.LastOrDefault(), null));
                        }
                        catch (Exception exception)
                        {
                            rows.Add(new AppUpgradeCandidate(node.Id.Value, node.Name, app, null, exception.Message));
                        }
                    }
                }
                catch (Exception exception)
                {
                    nodeErrors.Add($"{node.Name}：{exception.Message}");
                }
            }
        }
        finally
        {
            _upgradeRows = rows;
            _upgradeSelected.RemoveWhere(key => rows.All(row => row.Key != key || !row.CanSelect));
            _upgradeTabLoading = false;
        }

        _upgradeTabError = nodeErrors.Count == 0
            ? null
            : "部分节点读取升级信息失败：" + string.Join("；", nodeErrors);
    }

    private void ToggleUpgradeRow(AppUpgradeCandidate row)
    {
        if (!row.CanSelect)
        {
            return;
        }

        if (!_upgradeSelected.Remove(row.Key))
        {
            _upgradeSelected.Add(row.Key);
        }
    }

    private void ToggleAllUpgradeRows(bool select)
    {
        if (!select)
        {
            _upgradeSelected.Clear();
            return;
        }

        foreach (var row in _upgradeRows.Where(row => row.CanSelect))
        {
            _upgradeSelected.Add(row.Key);
        }
    }

    private async Task StartBatchUpgradeAsync()
    {
        var rows = _upgradeRows
            .Where(row => row.CanSelect && _upgradeSelected.Contains(row.Key))
            .ToArray();
        if (rows.Length == 0)
        {
            _operationError = "请先勾选要升级的应用。";
            return;
        }

        var nodeIds = EnabledNodes
            .Where(node => rows.Any(row => row.NodeId == node.Id.Value))
            .Select(node => node.Id.Value)
            .ToArray();

        var targets = new JsonArray();
        foreach (var row in rows)
        {
            targets.Add(new JsonObject
            {
                ["nodeId"] = row.NodeId.ToString("D"),
                ["installId"] = row.App.Id,
                ["name"] = row.App.Name,
                ["version"] = row.Latest!.Version,
                ["detailId"] = row.Latest.DetailId
            });
        }

        var parameters = new JsonObject
        {
            ["backup"] = _upgradeBackup,
            ["pullImage"] = _upgradePullImage,
            ["deleteImage"] = _upgradeDeleteImage,
            ["targets"] = targets
        };

        await PreviewAsync("app.batch_upgrade", parameters, nodeIds);
    }

