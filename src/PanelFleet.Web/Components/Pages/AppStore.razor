@page "/appstore"
@attribute [Authorize]
@using System.Text.Json.Nodes
@using PanelFleet.Application.AppStore
@using PanelFleet.Web.Components.AppStore
@inject INodeService NodeService
@inject AppStoreService Store
@inject IWriteOperationService Operations
@inject IActorProvider ActorProvider

<PageTitle>应用商店</PageTitle>

<div class="page-header">
    <h1>应用商店</h1>
    <div class="actions">
        @if (_viewMode == "node" && _nodeId is not null)
        {
            <button type="button" class="btn btn-primary" @onclick="OpenInstallWizardAsync" disabled="@(_busy || EnabledNodes.Count == 0)">
                安装应用
            </button>
        }
        <button type="button" class="btn" @onclick="RefreshAsync" disabled="@(_loading || _busy)">刷新</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_nodeError))
{
    <div class="alert alert-error">节点列表加载失败：@_nodeError</div>
}

@if (_nodesLoaded && _nodes.Count == 0)
{
    <div class="card">
        <p class="muted">还没有节点，先到 <a href="/nodes/new">添加节点</a> 接入第一台 1Panel，再使用应用商店。</p>
    </div>
}
else
{
    <AppStoreLayout>
        <Tree>
            <div class="tree-panel-head">
                <strong>节点与应用</strong>
                <span class="muted small">@EnabledNodes.Count 个启用节点</span>
            </div>
            <NavTree Nodes="BuildTreeNodes()"
                     SelectedId="@_selectedTreeId"
                     OnSelect="OnTreeSelectAsync"
                     OnToggle="OnTreeToggleAsync"
                     SelectableBranches="true"
                     Searchable="true"
                     SearchPlaceholder="搜索节点或应用…"
                     EmptyText="还没有可用节点"
                     AriaLabel="节点与应用导航" />
            <p class="muted small tree-panel-tip">
                选择节点后在右侧管理应用商店与已安装应用；「已安装应用」叶子可直接定位到该应用并打开参数与操作。
            </p>
        </Tree>

        <ChildContent>
            @if (_viewMode == "aggregate")
            {
                <div class="work-head">
                    <div class="work-title">
                        <h2>全部节点</h2>
                        <span class="badge badge-unknown">只读汇总</span>
                    </div>
                    <div class="actions">
                        <button type="button" class="btn" @onclick="ShowAggregateAsync" disabled="@_aggregateLoading">刷新汇总</button>
                    </div>
                    <span class="work-sub muted small">
                        汇总所有启用节点的已安装应用，便于跨节点巡检；安装、升级、卸载与配置修改需要先在左侧选择具体节点。
                    </span>
                </div>

                @if (!string.IsNullOrWhiteSpace(_aggregateError))
                {
                    <div class="alert alert-warn">@_aggregateError</div>
                }

                @if (_aggregateLoading)
                {
                    <div class="skeleton-stack">
                        @for (var i = 0; i < 4; i++)
                        {
                            <div class="skeleton-row"></div>
                        }
                    </div>
                }
                else if (_aggregateRows.Count == 0)
                {
                    <div class="work-empty">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" rx="2"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="2"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="2"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="2"></rect>
                        </svg>
                        <p>所有启用节点都还没有已安装应用。</p>
                        <p class="muted small">从左侧选择节点，在「应用商店」中搜索并安装应用。</p>
                    </div>
                }
                else
                {
                    <div class="work-card">
                        <div class="table-wrap">
                            <table class="table aggregate-table">
                                <thead>
                                    <tr>
                                        <th>节点</th>
                                        <th>应用</th>
                                        <th>版本</th>
                                        <th>状态</th>
                                        <th>端口</th>
                                        <th>操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _aggregateRows)
                                    {
                                        <tr>
                                            <td>
                                                <div class="aggregate-node">
                                                    <span>@row.NodeName</span>
                                                    @if (FindNode(row.NodeId) is { } rowNode)
                                                    {
                                                        <span class="badge @HealthBadgeClass(rowNode)">@HealthText(rowNode)</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div>@row.App.Name</div>
                                                <div class="muted small">@(row.App.AppName ?? row.App.AppKey)</div>
                                            </td>
                                            <td>@row.App.Version</td>
                                            <td>
                                                <span class="badge @StatusClass(row.App.Status)">@StatusText(row.App.Status)</span>
                                            </td>
                                            <td class="muted">@(row.App.HttpPort is { } port ? port.ToString() : "-")</td>
                                            <td>
                                                <button type="button" class="btn" @onclick="() => OnAggregateOpenAsync(row)" disabled="@_busy">查看</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
            else if (_nodeId is null)
            {
                <div class="work-empty">
                    <p>请先在左侧选择一个启用节点。</p>
                </div>
            }
            else
            {
                <div class="work-head">
                    <div class="work-title">
                        @if (CurrentNode is { } node)
                        {
                            <span class="health-dot @HealthDotClass(node)"></span>
                            <h2>@node.Name</h2>
                            <span class="badge @HealthBadgeClass(node)">@HealthText(node)</span>
                            @if (!string.IsNullOrWhiteSpace(node.PanelVersion))
                            {
                                <span class="badge badge-unknown">1Panel v@(node.PanelVersion)</span>
                            }
                            <span class="muted small">@node.BaseUrl.Host</span>
                        }
                        else
                        {
                            <h2>@(_nodeId?.Value.ToString() ?? "节点")</h2>
                        }
                    </div>
                    <div class="actions">
                        <button type="button" class="btn btn-primary" @onclick="OpenInstallWizardAsync" disabled="@_busy">安装应用</button>
                        <button type="button" class="btn" @onclick="RefreshAsync" disabled="@(_loading || _busy)">刷新</button>
                    </div>
                    <span class="work-sub muted small">
                        从该节点上下文发起安装、升级、卸载与配置修改（目标节点已锁定）；左侧树可快速定位已安装应用。
                    </span>
                </div>

                <div class="appstore-tabs">
                    <button type="button" class="tab @(_tab == "store" ? "active" : null)" @onclick='() => SwitchTabAsync("store")'>
                        应用商店
                    </button>
                    <button type="button" class="tab @(_tab == "installed" ? "active" : null)" @onclick='() => SwitchTabAsync("installed")'>
                        已安装应用@(_installedTotal > 0 ? $"（{_installedTotal}）" : string.Empty)
                    </button>
                    <button type="button" class="tab @(_tab == "upgrade" ? "active" : null)" @onclick='() => SwitchTabAsync("upgrade")'>
                        可升级@(_upgradeRows.Count > 0 ? $"（{_upgradeRows.Count}）" : string.Empty)
                    </button>
                </div>

                @if (_tab == "store")
                {
                    <div class="store-toolbar">
                        <label class="toolbar-field">
                            <span class="toolbar-label">搜索</span>
                            <input class="search-input" placeholder="应用名称…" @bind="_storeName" @bind:event="oninput" @onkeydown="OnStoreSearchKeyDown" />
                        </label>
                        <label class="toolbar-field">
                            <span class="toolbar-label">分类</span>
                            <select @bind="_storeTag" @bind:after="SearchStoreAsync">
                                <option value="">全部分类</option>
                                @foreach (var tag in _tags)
                                {
                                    <option value="@tag.Key">@tag.Name</option>
                                }
                            </select>
                        </label>
                        <button type="button" class="btn btn-primary" @onclick="SearchStoreAsync" disabled="@_storeLoading">搜索</button>
                        <span class="muted small">共 @_storeTotal 个应用 · 第 @_storePage/@StoreTotalPages 页</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_storeError))
                    {
                        <div class="alert alert-error">@_storeError</div>
                    }

                    @if (_storeLoading)
                    {
                        <div class="skeleton-grid">
                            @for (var i = 0; i < 6; i++)
                            {
                                <div class="skeleton-card"></div>
                            }
                        </div>
                    }
                    else if (_storeItems.Count == 0)
                    {
                        <div class="resource-empty">
                            <p>没有匹配的应用，可尝试清空分类或关键词。</p>
                        </div>
                    }
                    else
                    {
                        <div class="appstore-grid">
                            @foreach (var item in _storeItems)
                            {
                                <AppStoreCard App="item"
                                              Selected="_detail is not null && _detail.Key == item.Key"
                                              OnDetail="OpenDetailAsync"
                                              OnInstall="OpenInstallRequestedAsync" />
                            }
                        </div>
                        <div class="resource-pagination">
                            <button type="button" class="btn" @onclick="PreviousStorePageAsync" disabled="@(_storeLoading || _storePage <= 1)">上一页</button>
                            <button type="button" class="btn" @onclick="NextStorePageAsync" disabled="@(_storeLoading || _storePage >= StoreTotalPages)">下一页</button>
                        </div>
                    }
                }
                else if (_tab == "upgrade")
                {
                    <div class="store-toolbar">
                        <button type="button" class="btn" @onclick="LoadUpgradeCandidatesAsync" disabled="@(_upgradeTabLoading || _busy)">刷新可升级</button>
                        <label class="checkbox-inline"><input type="checkbox" @bind="_upgradeBackup" /><span>升级前备份</span></label>
                        <label class="checkbox-inline"><input type="checkbox" @bind="_upgradePullImage" /><span>拉取新镜像</span></label>
                        <label class="checkbox-inline"><input type="checkbox" @bind="_upgradeDeleteImage" /><span>删除旧镜像</span></label>
                        <button type="button" class="btn btn-primary" @onclick="StartBatchUpgradeAsync" disabled="@(_busy || UpgradeSelectedCount == 0)">
                            批量升级
                        </button>
                        <span class="muted small">已选 @UpgradeSelectedCount 个应用 / @UpgradeSelectedNodeCount 个节点</span>
                    </div>

                    <p class="muted small">
                        汇总所有启用节点的可升级应用（跨节点只读聚合）；勾选后可一次提交批量升级。
                        执行时按节点顺序串行升级，任一应用失败即停止，不自动重试、不回滚。
                    </p>

                    @if (!string.IsNullOrWhiteSpace(_upgradeTabError))
                    {
                        <div class="alert alert-warn">@_upgradeTabError</div>
                    }

                    <AppUpgradeTable Rows="_upgradeRows"
                                     Busy="_upgradeTabLoading"
                                     SelectedKeys="_upgradeSelected"
                                     OnToggle="ToggleUpgradeRow"
                                     OnToggleAll="ToggleAllUpgradeRows"
                                     OnUpgrade="UpgradeCandidateAsync"
                                     OnRefresh="LoadUpgradeCandidatesAsync" />
                }
                else
                {
                    <div class="store-toolbar">
                        <label class="toolbar-field">
                            <span class="toolbar-label">搜索</span>
                            <input class="search-input" placeholder="安装名称…" @bind="_installedName" @bind:event="oninput" @onkeydown="OnInstalledSearchKeyDown" />
                        </label>
                        <label class="checkbox-inline">
                            <input type="checkbox" @bind="_updateOnly" @bind:after="LoadInstalledAsync" />
                            <span>仅显示可升级</span>
                        </label>
                        <button type="button" class="btn btn-primary" @onclick="LoadInstalledAsync" disabled="@_installedLoading">刷新列表</button>
                        <span class="muted small">共 @_installedTotal 个应用 · 第 @_installedPage/@InstalledTotalPages 页</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_installedError))
                    {
                        <div class="alert alert-error">@_installedError</div>
                    }

                    @if (_installedLoading)
                    {
                        <div class="skeleton-stack">
                            @for (var i = 0; i < 4; i++)
                            {
                                <div class="skeleton-row"></div>
                            }
                        </div>
                    }
                    else
                    {
                        <InstalledAppTable Items="_installedItems"
                                           HighlightId="_installedDetailItem?.Id"
                                           Busy="_busy"
                                           OnDetail="OpenInstalledDetailAsync"
                                           OnEditParams="OpenParamsAsync"
                                           OnUpgrade="OpenUpgradeAsync"
                                           OnUninstall="OpenUninstallAsync" />
                        <div class="resource-pagination">
                            <button type="button" class="btn" @onclick="PreviousInstalledPageAsync" disabled="@(_installedLoading || _installedPage <= 1)">上一页</button>
                            <button type="button" class="btn" @onclick="NextInstalledPageAsync" disabled="@(_installedLoading || _installedPage >= InstalledTotalPages)">下一页</button>
                        </div>
                    }
                }

                @if (_installPanelOpen)
                {
                    <div class="install-panel card">
                        <div class="install-panel-head">
                            <h2>安装应用</h2>
                            <button type="button" class="btn" @onclick="CloseInstallPanel" disabled="@_busy">关闭</button>
                        </div>

                        <AppTargetNodeStep Nodes="_nodes"
                                           SelectedNodeId="_installNodeId"
                                           Locked="false"
                                           Busy="_busy"
                                           OnSelect="OpenInstallNodeSelectedAsync" />

                        @if (_installNodeId is null)
                        {
                            <p class="muted">请先选择目标节点，然后在应用列表点击「安装」选择要安装的应用。</p>
                        }
                        else if (_detailLoading)
                        {
                            <div class="skeleton-stack">
                                @for (var i = 0; i < 3; i++)
                                {
                                    <div class="skeleton-row"></div>
                                }
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_detailError))
                        {
                            <div class="alert alert-error">@_detailError</div>
                        }
                        else if (_detail is not null && !string.IsNullOrWhiteSpace(_pendingAppKey))
                        {
                            <div class="install-app-summary">
                                <div class="install-app-title">
                                    <strong>@_detail.Name</strong>
                                    <span class="muted small">@_detail.Key · @_detail.Type · 版本 @_detail.Version</span>
                                </div>
                                <button type="button" class="btn" @onclick="OpenDetailDrawerAsync" disabled="@_busy">查看应用详情</button>
                            </div>
                            <InstallAppForm Detail="_detail"
                                            Busy="_busy"
                                            NodeReady="_installNodeId is not null"
                                            OnVersionChanged="ChangeVersionAsync"
                                            OnSubmit="StartInstallAsync" />
                        }
                        else
                        {
                            <p class="muted small">
                                已选择节点「@InstallNodeName」，请在「应用商店」列表中点击目标应用的「安装」按钮加载安装参数。
                            </p>
                        }
                    </div>
                }

                @if (_installedDetail is not null || _installedDetailLoading)
                {
                    <div class="install-panel card">
                        <div class="install-panel-head">
                            <h2>应用详情</h2>
                            <div class="actions">
                                @if (_installedDetailItem is not null)
                                {
                                    <button type="button" class="btn" @onclick="OpenDetailParamsAsync" disabled="@_busy">修改配置</button>
                                    <button type="button" class="btn" @onclick="OpenDetailUpgradeAsync" disabled="@_busy">升级</button>
                                    <button type="button" class="btn btn-danger" @onclick="OpenDetailUninstallAsync" disabled="@_busy">卸载</button>
                                }
                                <button type="button" class="btn" @onclick="CloseInstalledDetail">关闭</button>
                            </div>
                        </div>
                        @if (_installedDetailLoading)
                        {
                            <div class="skeleton-stack">
                                @for (var i = 0; i < 3; i++)
                                {
                                    <div class="skeleton-row"></div>
                                }
                            </div>
                        }
                        else if (_installedDetail is { } detail)
                        {
                            @if (!string.IsNullOrWhiteSpace(_installedDetailError))
                            {
                                <div class="alert alert-error">@_installedDetailError</div>
                            }
                            <table class="table">
                                <tbody>
                                    <tr><th>名称</th><td>@detail.Name</td></tr>
                                    <tr><th>版本</th><td>@detail.Version</td></tr>
                                    <tr><th>状态</th><td>@StatusText(detail.Status)</td></tr>
                                    <tr><th>端口</th><td>@(detail.HttpPort?.ToString() ?? "-")</td></tr>
                                    <tr><th>容器</th><td>@(detail.Container ?? "-")</td></tr>
                                    <tr><th>编排文件</th><td class="detail-cell">@(detail.ComposePath ?? "-")</td></tr>
                                    <tr><th>应用 key</th><td>@(detail.AppKey ?? "-")</td></tr>
                                    <tr><th>端口列表</th><td>@string.Join(", ", detail.AppPorts)</td></tr>
                                </tbody>
                            </table>
                            @if (detail.Env.Count > 0)
                            {
                                <h3>环境变量（敏感值仅展示键名）</h3>
                                <table class="table">
                                    <thead><tr><th>键</th><th>值</th></tr></thead>
                                    <tbody>
                                        @foreach (var pair in detail.Env)
                                        {
                                            <tr>
                                                <td>@pair.Key</td>
                                                <td>@(IsSensitiveKey(pair.Key) ? "********" : pair.Value)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                    </div>
                }
            }
        </ChildContent>
    </AppStoreLayout>
}

@if (_detailDrawerOpen)
{
    <AppStoreDetailDrawer Detail="_detail"
                          Loading="_detailLoading"
                          Error="@_detailError"
                          Installed="_detail?.Installed == true"
                          NodeName="@CurrentNode?.Name"
                          Busy="_busy"
                          OnClose="CloseDetailDrawer"
                          OnInstall="InstallFromDetailDrawerAsync" />
}

@if (!string.IsNullOrWhiteSpace(_operationError))
{
    <div class="alert alert-error">@_operationError</div>
}

@if (_execution is not null)
{
    <div class="operation-panel card">
        <div class="install-panel-head">
            <h2>执行结果</h2>
            <button type="button" class="btn" @onclick="CloseResult">关闭</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_taskHint))
        {
            <p class="muted small">@_taskHint</p>
        }
        <OperationResultView Execution="_execution" />
        @if (_activeTaskId is not null && _activeTaskNodeId is not null)
        {
            <AppTaskProgress NodeId="@_activeTaskNodeId" TaskId="@_activeTaskId" OnFinished="OnTaskFinishedAsync" />
        }
        <p class="muted small">完整执行记录可在 <a href="/audit">审计</a> 页面查看（operation.executed / operation.batch）。</p>
    </div>
}

@if (_upgradeTarget is not null)
{
    <div class="modal-backdrop" @onclick="CloseUpgrade">
        <div class="modal appstore-modal" @onclick:stopPropagation="true">
            <h2>升级 @_upgradeTarget.Name</h2>
            <p class="muted small">目标节点：@(_upgradeNodeName ?? NodeNameOf(_upgradeTarget)) · 已锁定。</p>
            @if (_upgradeLoading)
            {
                <p class="muted">正在查询可用升级版本…</p>
            }
            else if (_upgradeVersions.Count == 0)
            {
                <div class="alert alert-warn">
                    当前没有可用的升级版本（可能已是最新版本），请先在 1Panel 中同步应用商店后重试。
                </div>
            }
            else
            {
                <div class="form-row">
                    <label class="form-label">目标版本</label>
                    <select @bind="_upgradeVersion">
                        @foreach (var version in _upgradeVersions)
                        {
                            <option value="@version">@version.Version（detailId @version.DetailId）</option>
                        }
                    </select>
                </div>
                <div class="form-row checkbox-row">
                    <label class="checkbox-inline"><input type="checkbox" @bind="_upgradeBackup" /><span>升级前备份</span></label>
                </div>
                <div class="form-row checkbox-row">
                    <label class="checkbox-inline"><input type="checkbox" @bind="_upgradePullImage" /><span>拉取新镜像</span></label>
                </div>
                <div class="form-row checkbox-row">
                    <label class="checkbox-inline"><input type="checkbox" @bind="_upgradeDeleteImage" /><span>升级后删除旧镜像</span></label>
                </div>
                <div class="alert alert-warn">升级会重建容器，可能短暂中断服务；不支持自动回滚。</div>
            }
            @if (!string.IsNullOrWhiteSpace(_upgradeError))
            {
                <div class="alert alert-error">@_upgradeError</div>
            }
            <div class="modal-actions">
                <button type="button" class="btn" @onclick="CloseUpgrade" disabled="@_busy">取消</button>
                <button type="button" class="btn btn-primary" @onclick="StartUpgradeAsync" disabled="@(_busy || _upgradeVersions.Count == 0)">
                    预览升级
                </button>
            </div>
        </div>
    </div>
}

@if (_uninstallTarget is not null)
{
    <div class="modal-backdrop" @onclick="CloseUninstall">
        <div class="modal appstore-modal" @onclick:stopPropagation="true">
            <h2>卸载 @_uninstallTarget.Name</h2>
            <p class="muted small">目标节点：@NodeNameOf(_uninstallTarget) · 已锁定（从节点上下文发起）。</p>
            @if (_deleteResourcesLoading)
            {
                <p class="muted">正在检查关联资源…</p>
            }
            else if (_deleteResources.Count > 0)
            {
                <div class="alert alert-warn">
                    该应用关联以下资源，卸载后将失去关联，请确认：
                    <ul>
                        @foreach (var resource in _deleteResources)
                        {
                            <li>@resource.Type：@resource.Name</li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <p class="muted small">未发现关联的数据库/网站等资源。</p>
            }

            <div class="form-row checkbox-row">
                <label class="checkbox-inline"><input type="checkbox" @bind="_uninstallForceDelete" /><span>强制卸载（容器异常时）</span></label>
            </div>
            <div class="form-row checkbox-row">
                <label class="checkbox-inline"><input type="checkbox" @bind="_uninstallDeleteBackup" /><span>同时删除备份</span></label>
            </div>
            <div class="form-row checkbox-row">
                <label class="checkbox-inline"><input type="checkbox" @bind="_uninstallDeleteImage" /><span>同时删除镜像</span></label>
            </div>
            <div class="form-row checkbox-row">
                <label class="checkbox-inline"><input type="checkbox" @bind="_uninstallDeleteDb" /><span>同时删除关联数据库（不可恢复）</span></label>
            </div>
            <div class="alert alert-error">卸载不可回滚；执行前需要输入节点名称确认。</div>
            @if (!string.IsNullOrWhiteSpace(_uninstallError))
            {
                <div class="alert alert-error">@_uninstallError</div>
            }
            <div class="modal-actions">
                <button type="button" class="btn" @onclick="CloseUninstall" disabled="@_busy">取消</button>
                <button type="button" class="btn btn-danger" @onclick="StartUninstallAsync" disabled="@_busy">预览卸载</button>
            </div>
        </div>
    </div>
}

@if (_paramsTarget is not null)
{
    <div class="modal-backdrop" @onclick="CloseParamsEditor">
        <div class="modal appstore-modal appstore-modal-wide" @onclick:stopPropagation="true">
            <p class="muted small">目标节点：@NodeNameOf(_paramsTarget) · 已锁定（从节点上下文发起）。</p>
            @if (_paramsLoading)
            {
                <p class="muted">正在加载应用配置…</p>
                <div class="modal-actions">
                    <button type="button" class="btn" @onclick="CloseParamsEditor">关闭</button>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_paramsError))
            {
                <div class="alert alert-error">@_paramsError</div>
                <div class="modal-actions">
                    <button type="button" class="btn" @onclick="CloseParamsEditor">关闭</button>
                </div>
            }
            else
            {
                <InstalledParamsEditor Config="_paramsConfig"
                                       App="_paramsTarget"
                                       Busy="_busy"
                                       OnSubmit="StartParamsUpdateAsync"
                                       OnCancel="CloseParamsEditor" />
            }
        </div>
    </div>
}

<OperationConfirmDialog Preview="_preview" Busy="_busy" OnConfirm="ExecuteAsync" OnCancel="CancelPreviewAsync" />

@code {
