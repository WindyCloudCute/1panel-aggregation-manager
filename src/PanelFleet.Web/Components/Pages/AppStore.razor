        _detailError = null;
        _detail = null;
        try
        {
            _detail = await Store.GetDetailAsync(nodeId, appKey, version, default);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            _detailError = "加载应用详情失败：" + exception.Message;
        }
        finally
        {
            _detailLoading = false;
