    protected override async Task OnInitializedAsync()
    {
        _actor = await ActorProvider.GetAsync();
        _loading = true;
        try
        {
            _nodes = await NodeService.ListAsync(default);
            _nodesLoaded = true;
        }
        catch (Exception exception)
        {
            _nodes = [];
            _nodesLoaded = true;
            _nodeError = exception.Message;
        }
        finally
        {
            _loading = false;
        }

        var enabled = EnabledNodes;
        Guid? target = QueryNodeId;
        if (target is null || enabled.All(node => node.Id.Value != target.Value))
        {
            target = enabled.Count > 0 ? enabled[0].Id.Value : null;
        }

        if (target is null)
        {
            return;
        }

        SelectNode(target.Value);
        _selectedTreeId = $"node:{target.Value:D}";
        _expandedNodeId = target.Value;
        await LoadStoreAreaAsync();

        if (string.Equals(QueryTab, "installed", StringComparison.OrdinalIgnoreCase))
        {
            _tab = "installed";
        }
        else if (string.Equals(QueryTab, "upgrade", StringComparison.OrdinalIgnoreCase))
        {
            _tab = "upgrade";
            await LoadUpgradeCandidatesAsync();
        }

        if (QueryInstallId is { } installId)
        {
            _viewMode = "node";
            _tab = "installed";
            await EnsureTreeAppsAsync(target.Value);
            await OpenInstalledDetailByIdAsync(installId);
        }
        else if (!string.IsNullOrWhiteSpace(QueryAppKey))
