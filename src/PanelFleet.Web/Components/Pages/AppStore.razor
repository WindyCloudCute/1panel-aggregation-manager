    // —— 左侧树 ——
    private IReadOnlyList<NavTreeNode> BuildTreeNodes()
    {
        var enabled = EnabledNodes;
        var root = new NavTreeNode
        {
            Id = AllNodesId,
            Label = "全部节点",
            Hint = $"{enabled.Count} 个启用节点 · 只读汇总",
            BadgeText = "汇总",
            BadgeClass = "badge-unknown",
            DefaultExpanded = true,
            Children = enabled.Select(BuildNodeBranch).ToArray()
        };
        return [root];
    }

    private NavTreeNode BuildNodeBranch(NodeSummary node)
    {
        var nodeId = node.Id.Value;
        var children = new List<NavTreeNode>();
        if (_treeAppsLoaded.Contains(nodeId) && _treeApps.TryGetValue(nodeId, out var apps))
        {
            children.AddRange(apps.Select(app => new NavTreeNode
            {
                Id = $"app:{nodeId:D}:{app.Id}",
                Kind = NavTreeNodeKind.Leaf,
                Label = app.Name,
                Hint = $"{app.Version} · {StatusText(app.Status)}",
                BadgeText = app.CanUpdate ? "可升级" : null,
                BadgeClass = "badge-warn"
            }));
        }

        var failed = _treeAppsFailed.Contains(nodeId);
        return new NavTreeNode
        {
            Id = $"node:{nodeId:D}",
            Label = node.Name,
            Hint = NodeHint(node),
            BadgeText = HealthText(node),
            BadgeClass = HealthBadgeClass(node),
            IsDisabled = !node.IsEnabled,
            IsLoading = _treeAppsLoading.Contains(nodeId),
            ChildrenLoaded = _treeAppsLoaded.Contains(nodeId),
            Error = failed ? "已安装应用加载失败，收起后重新展开可重试" : null,
            DefaultExpanded = _expandedNodeId == nodeId,
            Children = children
        };
    }

    private async Task OnTreeSelectAsync(NavTreeNode node)
    {
        if (node.Id == AllNodesId)
        {
            _viewMode = "aggregate";
            _selectedTreeId = AllNodesId;
            _tab = "store";
            _preview = null;
            _installedDetail = null;
            _installedDetailItem = null;
            _installPanelOpen = false;
            _operationError = null;
            await ShowAggregateAsync();
            return;
        }

        if (node.Id.StartsWith("node:", StringComparison.Ordinal))
        {
            if (!Guid.TryParse(node.Id[5..], out var nodeId))
            {
                return;
            }

            await SelectNodeContextAsync(nodeId);
            return;
        }

        if (node.Id.StartsWith("app:", StringComparison.Ordinal))
        {
            var parts = node.Id.Split(':');
            if (parts.Length == 3 && Guid.TryParse(parts[1], out var nodeId) && long.TryParse(parts[2], out var installId))
            {
                await SelectInstalledAppAsync(nodeId, installId);
            }
        }
    }

    private async Task OnTreeToggleAsync(NavTreeNode node)
    {
        if (node.Id.StartsWith("node:", StringComparison.Ordinal)
            && Guid.TryParse(node.Id[5..], out var nodeId))
        {
            await EnsureTreeAppsAsync(nodeId);
        }
    }

    private async Task SelectNodeContextAsync(Guid nodeId)
    {
        _viewMode = "node";
        _selectedTreeId = $"node:{nodeId:D}";
        _expandedNodeId = nodeId;
        if (_nodeId?.Value != nodeId)
        {
            SelectNode(nodeId);
            await LoadStoreAreaAsync();
        }

        await EnsureTreeAppsAsync(nodeId);
