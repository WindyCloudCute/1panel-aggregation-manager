                    var page = await Store.SearchInstalledAsync(node.Id, null, null, false, false, 1, 200, default);
                    rows.AddRange(page.Items.Select(app => new AggregateAppRow(node.Id.Value, node.Name, app)));
                }
                catch (OperationCanceledException)
                {
                }
                catch (Exception)
                {
                    _aggregateError = "部分节点的已安装应用加载失败，汇总结果可能不完整。";
                }
            }

            _aggregateRows = rows;
        }
        finally
        {
            _aggregateLoading = false;
        }
    }

    // —— 节点数据加载 ——
