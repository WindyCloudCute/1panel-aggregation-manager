    private async Task PreviewAsync(string kind, JsonObject parameters, IReadOnlyList<Guid>? nodeIdsOverride = null)
    {
        IReadOnlyList<NodeId> nodeIds = nodeIdsOverride is { Count: > 0 }
            ? nodeIdsOverride.Select(id => new NodeId(id)).ToArray()
            : _nodeId is { } currentNodeId
                ? [currentNodeId]
                : [];
        if (nodeIds.Count == 0)
        {
            return;
        }

        _busy = true;
        _operationError = null;
        _execution = null;
        _preview = null;
        _taskHint = null;
        try
        {
            _preview = await Operations.PreviewAsync(
                new OperationInvocation(kind, nodeIds, parameters),
                _actor ?? ActorInfo.System,
                default);
        }
        catch (OperationValidationException exception)
        {
            _operationError = exception.Message;
        }
        catch (OperationNotSupportedException exception)
        {
            _operationError = exception.Message;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            _operationError = "预览失败：" + exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExecuteAsync(string? typedConfirmation)
    {
        if (_preview is not { } preview)
        {
            return;
        }

        _busy = true;
        _operationError = null;
        try
        {
            _execution = await Operations.ExecuteAsync(
                preview.TokenId,
                typedConfirmation,
                _actor ?? ActorInfo.System,
                default);
            _preview = null;

            var successStep = _execution.Steps.FirstOrDefault(step => step.Success);
            _activeTaskId = successStep?.TaskId;
            _activeTaskNodeId = successStep?.NodeId;
            _taskHint = _activeTaskId is null
                ? "操作已提交；如为异步任务，请在已安装列表中刷新状态。"
                : "已提交 1Panel 异步任务，页面将自动轮询任务状态。";

            await LoadInstalledAsync();
            if (_nodeId is { } nodeId)
            {
                _treeAppsLoaded.Remove(nodeId.Value);
                await EnsureTreeAppsAsync(nodeId.Value);
            }

            if (_tab == "store")
            {
                await SearchStoreAsync();
            }
            else if (_tab == "upgrade")
            {
                await LoadUpgradeCandidatesAsync();
            }
        }
        catch (OperationConfirmationException exception)
        {
            _operationError = exception.Message;
        }
        catch (OperationValidationException exception)
        {
            _operationError = exception.Message;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            _operationError = "执行失败：" + exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelPreviewAsync() => _preview = null;

    private void CloseResult()
    {
        _execution = null;
        _activeTaskId = null;
        _activeTaskNodeId = null;
        _taskHint = null;
    }

    private async Task OnTaskFinishedAsync()
    {
        await LoadInstalledAsync();
        if (_nodeId is { } nodeId)
        {
            _treeAppsLoaded.Remove(nodeId.Value);
            await EnsureTreeAppsAsync(nodeId.Value);
        }
    }

    private static void AddIfNotNull(JsonObject target, string key, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            target[key] = value;
        }
    }

    private static bool IsSensitiveKey(string key) =>
        key.Contains("PASSWORD", StringComparison.OrdinalIgnoreCase)
        || key.Contains("SECRET", StringComparison.OrdinalIgnoreCase)
        || key.Contains("TOKEN", StringComparison.OrdinalIgnoreCase);

    private NodeSummary? FindNode(Guid nodeId) => _nodes.FirstOrDefault(node => node.Id.Value == nodeId);

    private string NodeNameOf(InstalledAppItem app) =>
        _nodeId is { } nodeId ? NodeNameOf(nodeId) : "-";

    private string NodeNameOf(NodeId nodeId) => NodeNameOf(nodeId.Value);

    private string NodeNameOf(Guid nodeId) =>
        FindNode(nodeId)?.Name ?? nodeId.ToString("N");

    private static string NodeHint(NodeSummary node)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(node.PanelVersion))
        {
            parts.Add("v" + node.PanelVersion);
        }

        if (node.BaseUrl is { } url)
        {
            parts.Add(url.Host);
        }

        return string.Join(" · ", parts);
    }

    private static string HealthDotClass(NodeSummary node) => node.Health switch
    {
        NodeHealth.Online => "health-online",
        NodeHealth.Degraded => "health-degraded",
        NodeHealth.Offline => "health-offline",
        _ => "health-unknown"
    };

    private static string HealthBadgeClass(NodeSummary node) => node.Health switch
    {
        NodeHealth.Online => "badge-ok",
        NodeHealth.Degraded => "badge-warn",
        NodeHealth.Offline => "badge-error",
        _ => "badge-unknown"
    };

    private static string HealthText(NodeSummary node) => node.Health switch
    {
        NodeHealth.Online => "在线",
        NodeHealth.Degraded => "降级",
        NodeHealth.Offline => "离线",
        _ => "健康未知"
    };

    private static string StatusClass(string? status) => status switch
    {
        "Running" => "badge-ok",
        "Stopped" => "badge-unknown",
        "Installing" or "Upgrading" or "Rebuilding" or "Uninstalling" or "Downloading" => "badge-warn",
        "Error" or "InstallErr" or "DownloadErr" or "UpgradeErr" => "badge-error",
        _ => "badge-unknown"
    };

    private static string StatusText(string? status) => status switch
    {
        "Running" => "运行中",
        "Stopped" => "已停止",
        "Installing" => "安装中",
        "Upgrading" => "升级中",
        "Rebuilding" => "重建中",
        "Uninstalling" => "卸载中",
        "Downloading" => "下载中",
        "Error" or "InstallErr" or "DownloadErr" or "UpgradeErr" => "异常",
        null or "" => "未知",
        _ => status
    };

