    private async Task SelectInstalledAppAsync(Guid nodeId, long installId)
    {
        _viewMode = "node";
        _tab = "installed";
        _selectedTreeId = $"app:{nodeId:D}:{installId}";
        _expandedNodeId = nodeId;
        if (_nodeId?.Value != nodeId)
        {
            SelectNode(nodeId);
            await LoadStoreAreaAsync();
        }

        await EnsureTreeAppsAsync(nodeId);
        await OpenInstalledDetailByIdAsync(installId);
    }

    private async Task EnsureTreeAppsAsync(Guid nodeId)
    {
        if (_treeAppsLoaded.Contains(nodeId) || _treeAppsLoading.Contains(nodeId))
        {
            return;
        }

        _treeAppsLoading.Add(nodeId);
        _treeAppsFailed.Remove(nodeId);
        try
        {
            var page = await Store.SearchInstalledAsync(new NodeId(nodeId), null, null, false, false, 1, 100, default);
            _treeApps[nodeId] = page.Items.ToList();
            _treeAppsLoaded.Add(nodeId);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            _treeApps.Remove(nodeId);
            _treeAppsLoaded.Remove(nodeId);
            _treeAppsFailed.Add(nodeId);
        }
        finally
        {
            _treeAppsLoading.Remove(nodeId);
        }
    }

    private async Task OnAggregateOpenAsync(AggregateAppRow row) =>
        await SelectInstalledAppAsync(row.NodeId, row.App.Id);

    private async Task ShowAggregateAsync()
    {
        _aggregateLoading = true;
        _aggregateError = null;
        var rows = new List<AggregateAppRow>();
        try
        {
            foreach (var node in EnabledNodes)
