    private IReadOnlyList<NodeSummary> EnabledNodes => _nodes.Where(node => node.IsEnabled).ToArray();

    private NodeSummary? CurrentNode => _nodeId is { } id
        ? _nodes.FirstOrDefault(node => node.Id == id)
