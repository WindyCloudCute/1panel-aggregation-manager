@* 面板更新工作台：左侧节点勾选树 + 右侧版本检查与升级操作。 *@
<div class="update-workbench">
    <aside class="update-workbench-tree">
        @Tree
    </aside>
    <section class="update-workbench-main">
        @Main
    </section>
</div>

@code {
    /// <summary>左侧节点树内容。</summary>
    [Parameter]
    public RenderFragment? Tree { get; set; }

    /// <summary>右侧版本汇总、批量操作与版本表格。</summary>
    [Parameter]
    public RenderFragment? Main { get; set; }
}
